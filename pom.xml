<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.fturleque</groupId>
    <artifactId>nexus-context-engine-parent</artifactId>
    <version>0.2.1-rc.1</version>
    <packaging>pom</packaging>
    <name>NEXUS Context Engine Reactor</name>
    <description>Reactor et gouvernance de build communs au cœur NEXUS et à ses adaptateurs optionnels.</description>

    <licenses>
        <license>
            <name>NEXUS Proprietary Source-Available License - All Rights Reserved</name>
            <url>https://github.com/FTurleque/nexus-context-engine/blob/main/LICENSE</url>
            <distribution>repo</distribution>
            <comments>Copyright (c) 2026 Fabrice Turleque. No general use, modification, distribution or commercial license is granted.</comments>
        </license>
    </licenses>

    <modules>
        <module>core</module>
        <module>adapters/rest-quarkus</module>
        <module>adapters/mcp-java</module>
        <module>adapters/assistant-clients</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Horodatage des entrées des JAR et du ZIP de distribution (build reproductible).
             Mis à jour avec la version à chaque release : docs/developer/release-and-recovery.md. -->
        <project.build.outputTimestamp>2026-11-11T00:00:00Z</project.build.outputTimestamp>
        <argLine></argLine>
        <nexus.runtime.nativeAccessArg>--enable-native-access=ALL-UNNAMED</nexus.runtime.nativeAccessArg>
        <nexus.coverage.line.minimum>0.65</nexus.coverage.line.minimum>
        <nexus.coverage.branch.minimum>0.55</nexus.coverage.branch.minimum>
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>

        <javaparser.version>3.28.2</javaparser.version>
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <lucene.version>10.6.0</lucene.version>
        <jgit.version>7.8.1.202611041320-r</jgit.version>
        <jackson.version>2.22.4</jackson.version>
        <micrometer.version>1.17.2</micrometer.version>
        <snakeyaml-engine.version>3.2</snakeyaml-engine.version>
        <jna.version>5.19.1</jna.version>
        <junit.version>6.1.3</junit.version>
        <mcp.sdk.version>2.1.0</mcp.sdk.version>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.40.1.1</quarkus.platform.version>

        <maven.clean-plugin.version>3.5.0</maven.clean-plugin.version>
        <maven.resources-plugin.version>3.5.0</maven.resources-plugin.version>
        <maven.jar-plugin.version>3.5.1</maven.jar-plugin.version>
        <maven.install-plugin.version>3.2.0</maven.install-plugin.version>
        <maven.deploy-plugin.version>3.2.0</maven.deploy-plugin.version>
        <maven.site-plugin.version>3.22.0</maven.site-plugin.version>
        <maven.compiler-plugin.version>3.16.0</maven.compiler-plugin.version>
        <maven.surefire-plugin.version>3.6.1</maven.surefire-plugin.version>
        <maven.shade-plugin.version>3.6.2</maven.shade-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <maven.enforcer-plugin.version>3.7.0</maven.enforcer-plugin.version>
        <maven.assembly-plugin.version>3.8.0</maven.assembly-plugin.version>
        <maven.antrun-plugin.version>3.2.0</maven.antrun-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <license-maven-plugin.version>2.8.0</license-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- jna est géré avec jna-platform : le BOM Quarkus le ramènerait sous la version
                 qu'exige jna-platform, ce que requireUpperBoundDeps refuse. -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <!-- These project-level BOMs intentionally precede Quarkus so Maven
                 cannot silently downgrade the security baselines selected here. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>${micrometer.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-core</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.lucene</groupId>
                <artifactId>lucene-queryparser</artifactId>
                <version>${lucene.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.snakeyaml</groupId>
                <artifactId>snakeyaml-engine</artifactId>
                <version>${snakeyaml-engine.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Plugins du cycle de vie épinglés : sans entrée ici, Maven choisirait la version
                     liée à sa propre distribution (requirePluginVersions le refuse). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Le site n'est pas produit, mais requirePluginVersions contrôle aussi le cycle site. -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven.site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire-plugin.version}</version>
                    <configuration>
                        <!-- Historical reactor-wide developer scripts may select a core-only
                             test name. CI overrides this property to fail closed. -->
                        <failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests>
                        <argLine>@{argLine} ${nexus.runtime.nativeAccessArg}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven.assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven.antrun-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${nexus.coverage.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${nexus.coverage.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-nexus-toolchain</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <!-- Aligné sur le wrapper (.mvn/wrapper/maven-wrapper.properties). -->
                                    <version>[3.10.0,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <requirePluginVersions>
                                    <message>Chaque plugin du build doit avoir une version explicite (pluginManagement du pom racine).</message>
                                    <banLatest>true</banLatest>
                                    <banRelease>true</banRelease>
                                    <banSnapshots>true</banSnapshots>
                                </requirePluginVersions>
                                <requireUpperBoundDeps>
                                    <!-- Exclusions justifiées : versions fixées par le BOM de la plate-forme Quarkus,
                                         qualifiée comme un ensemble ; la remonter pour le seul transitif
                                         diverge de la plate-forme sans correctif de sécurité en jeu.
                                         - org.jctools:jctools-core : 4.0.5 (BOM Quarkus), mutiny demande 4.0.6 ;
                                         - org.jspecify:jspecify : 1.0.0 (BOM Quarkus), Micrometer demande 1.0.1
                                           (annotations de nullité seulement).
                                         Revoir ces exclusions à chaque montée de quarkus.platform.version. -->
                                    <excludes>
                                        <exclude>org.jctools:jctools-core</exclude>
                                        <exclude>org.jspecify:jspecify</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>aggregate-third-party-notices</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>aggregate-add-third-party</goal>
                        </goals>
                        <configuration>
                            <acceptPomPackaging>true</acceptPomPackaging>
                            <includedScopes>compile,runtime</includedScopes>
                            <excludedGroups>io.github.fturleque</excludedGroups>
                            <failOnMissing>true</failOnMissing>
                            <!-- Liste blanche (AUD-DEP-07) : une dépendance livrée doit porter au moins une
                                 licence de cette liste ; une dépendance multi-licence est acceptée si l'une
                                 de ses licences y figure. Toute nouvelle licence exige une revue du pom. -->
                            <failOnBlacklist>true</failOnBlacklist>
                            <includedLicenses>
                                <includedLicense>Apache License, Version 2.0</includedLicense>
                                <includedLicense>BSD 2-Clause License</includedLicense>
                                <includedLicense>BSD 3-Clause License</includedLicense>
                                <includedLicense>MIT License</includedLicense>
                                <includedLicense>MIT No Attribution</includedLicense>
                                <includedLicense>CC0 1.0 Universal</includedLicense>
                                <includedLicense>Eclipse Public License 1.0</includedLicense>
                                <includedLicense>Eclipse Public License 2.0</includedLicense>
                                <includedLicense>Eclipse Distribution License 1.0</includedLicense>
                            </includedLicenses>
                            <!-- Libellé normalisé en premier, variantes déclarées par les dépendances ensuite. -->
                            <licenseMerges>
                                <licenseMerge>Apache License, Version 2.0|The Apache Software License, Version 2.0|The Apache License, Version 2.0|Apache License 2.0|Apache License Version 2.0|Apache License v2.0|Apache-2.0|Apache 2</licenseMerge>
                                <licenseMerge>BSD 2-Clause License|BSD-2-Clause</licenseMerge>
                                <licenseMerge>BSD 3-Clause License|BSD-3-Clause</licenseMerge>
                                <licenseMerge>MIT License|MIT</licenseMerge>
                                <licenseMerge>MIT No Attribution|MIT-0</licenseMerge>
                                <licenseMerge>CC0 1.0 Universal|Public Domain, per Creative Commons CC0</licenseMerge>
                                <licenseMerge>Eclipse Public License 1.0|Eclipse Public License - v 1.0</licenseMerge>
                                <licenseMerge>Eclipse Public License 2.0|Eclipse Public License - v 2.0|Eclipse Public License v. 2.0|EPL 2.0|EPL-2.0</licenseMerge>
                                <licenseMerge>Eclipse Distribution License 1.0|Eclipse Distribution License - v 1.0|EDL 1.0</licenseMerge>
                                <licenseMerge>GNU General Public License, version 2 with the GNU Classpath Exception|GPL2 w/ CPE|GPL-2.0-with-classpath-exception</licenseMerge>
                                <licenseMerge>GNU Lesser General Public License 2.1|LGPL, version 2.1|LGPL-2.1-or-later</licenseMerge>
                            </licenseMerges>
                            <deployMissingFile>false</deployMissingFile>
                            <useRepositoryMissingFiles>false</useRepositoryMissingFiles>
                            <sortArtifactByName>true</sortArtifactByName>
                            <outputDirectory>${project.build.directory}/licenses</outputDirectory>
                            <thirdPartyFilename>THIRD_PARTY_NOTICES.txt</thirdPartyFilename>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>aggregate-sbom</id>
                        <phase>verify</phase>
                        <goals><goal>makeAggregateBom</goal></goals>
                        <configuration>
                            <projectType>application</projectType>
                            <includeBomSerialNumber>true</includeBomSerialNumber>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                            <outputDirectory>${project.build.directory}/sbom</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ci-strict-specified-tests</id>
            <activation>
                <property>
                    <name>env.CI</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <surefire.failIfNoSpecifiedTests>true</surefire.failIfNoSpecifiedTests>
            </properties>
        </profile>
    </profiles>
</project>
