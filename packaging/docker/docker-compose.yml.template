name: "nexus-context-engine"
services:
  nexus:
    image: "${NEXUS_DOCKER_IMAGE:-nexus-context-engine:0.2.1}"
    pull_policy: build
    build:
      context: ..
      dockerfile: docker/Dockerfile.runtime
      # Labels OCI de l'image construite sur le poste, valeurs écrites dans .env par l'installateur.
      # Sans révision, le label org.opencontainers.image.revision vaut « unknown ».
      args:
        NEXUS_IMAGE_VERSION: "${NEXUS_IMAGE_VERSION:-}"
        NEXUS_IMAGE_REVISION: "${NEXUS_IMAGE_REVISION:-}"
    container_name: "${NEXUS_DOCKER_CONTAINER:-nexus-context-engine}"
    restart: "${NEXUS_DOCKER_RESTART_POLICY:-unless-stopped}"
    # Durcissement d'exécution : racine en lecture seule (NEXUS n'écrit que dans /data/nexus et
    # /tmp), aucune capacité Linux, aucune élévation de privilèges. L'image appartient à root ;
    # le processus tourne en UID 10001. /tmp est monté `exec` : SQLite et JNA y extraient puis
    # chargent leurs bibliothèques natives, ce qu'un tmpfs `noexec` (défaut Docker) refuse.
    read_only: true
    tmpfs:
      - "/tmp:exec,mode=1777"
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    environment:
      NEXUS_HOME: /data/nexus
      NEXUS_MODE: rest
      NEXUS_RUNTIME: "${NEXUS_RUNTIME:-docker}"
      NEXUS_REST_HOST: 0.0.0.0
      NEXUS_REST_PORT: "${NEXUS_DOCKER_CONTAINER_PORT:-8080}"
      NEXUS_REST_ALLOWED_PROJECT_ROOTS: "/workspace"
      NEXUS_REST_EXPOSURE_MODE: "${NEXUS_REST_EXPOSURE_MODE:-loopback-forward}"
      # Contractual declaration of the Docker host forward. It deliberately comes from the exact
      # same deployment variable as the published port below, so the official Compose path cannot
      # claim loopback-forward while publishing on a remote address.
      NEXUS_DOCKER_HOST_FORWARD_ADDRESS: "${NEXUS_DOCKER_BIND_ADDRESS:-127.0.0.1}"
      NEXUS_MAX_FILE_SIZE_BYTES: "${NEXUS_MAX_FILE_SIZE_BYTES:-8388608}"
      NEXUS_MAX_CONTEXT_MATERIALIZATION_BYTES: "${NEXUS_MAX_CONTEXT_MATERIALIZATION_BYTES:-67108864}"
      NEXUS_MAX_SCIP_INDEX_BYTES: "${NEXUS_MAX_SCIP_INDEX_BYTES:-268435456}"
      NEXUS_MAX_SCIP_MESSAGE_BYTES: "${NEXUS_MAX_SCIP_MESSAGE_BYTES:-16777216}"
      NEXUS_CODE_INTELLIGENCE_TIMEOUT_SECONDS: "${NEXUS_CODE_INTELLIGENCE_TIMEOUT_SECONDS:-180}"
      NEXUS_MAX_CONCURRENT_INDEXING: "${NEXUS_MAX_CONCURRENT_INDEXING:-2}"
      NEXUS_SEMANTIC_PROVIDER: "${NEXUS_SEMANTIC_PROVIDER:-}"
      NEXUS_OLLAMA_BASE_URL: "${NEXUS_OLLAMA_BASE_URL:-}"
      NEXUS_OLLAMA_EMBEDDING_MODEL: "${NEXUS_OLLAMA_EMBEDDING_MODEL:-}"
      NEXUS_OLLAMA_EMBEDDING_DIMENSIONS: "${NEXUS_OLLAMA_EMBEDDING_DIMENSIONS:-}"
      NEXUS_OLLAMA_TIMEOUT_SECONDS: "${NEXUS_OLLAMA_TIMEOUT_SECONDS:-}"
      # Fail-fast : le REST NEXUS refuse un bind non-loopback sans token. Le token généré par le
      # wizard contient 256 bits d'entropie ; en autonome, utilisez au moins 32 octets aléatoires.
      NEXUS_REST_API_TOKEN: "${NEXUS_REST_API_TOKEN:?NEXUS_REST_API_TOKEN is required (le wizard le génère automatiquement ; en autonome, définissez-le dans .env)}"
    # host.docker.internal pointe vers l'hôte : natif sur Docker Desktop, explicite ici pour rester
    # portable sur Docker Engine Linux (Ollama tournant sur la machine hôte).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "${NEXUS_DOCKER_BIND_ADDRESS:-127.0.0.1}:${NEXUS_DOCKER_HOST_PORT:-8080}:${NEXUS_DOCKER_CONTAINER_PORT:-8080}"
    volumes:
      # NEXUS_HOME_BIND is either a host path (bind mount) or "nexus-data", the named volume
      # declared below. The Windows installer uses the volume: a Windows bind mount refuses the
      # chmod with which NEXUS makes its storage private.
      - "${NEXUS_HOME_BIND:-./nexus-data}:/data/nexus"
      - "${NEXUS_REPOSITORY_BIND:-./workspace}:/workspace:ro"
    healthcheck:
      # Health/metrics live on the separate loopback-only management listener inside the container.
      # The probe is bundled in the image and requires no curl/wget package.
      test: ["CMD", "/usr/local/bin/nexus-healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s

volumes:
  nexus-data:
    name: "${NEXUS_DOCKER_DATA_VOLUME:-nexus-context-engine-data}"
