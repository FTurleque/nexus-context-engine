    ProfilePage.SelectedValueIndex := 0;
    SemanticPage.Values[0] := False;
    DockerPrereqPage.Values[0] := False;
    AssistantPage.Values[0] := False;
    AssistantPage.Values[1] := False;
    AssistantPage.Values[2] := False;
    AssistantPage.Values[3] := False;
    AssistantPage.Values[4] := False;
  end
  else
    LoadPreviousSettings;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = NativeOptionsPage.ID then Result := (not InstallNative()) or (not IsCustomProfile())
  else if PageID = RuntimePage.ID then Result := not IsCustomProfile()
  else if PageID = OllamaPage.ID then Result := (not OllamaEnabled()) or (not IsCustomProfile())
  else if PageID = DockerPrereqPage.ID then Result := (not InstallDocker()) or DockerRuntimePresent()
  else if PageID = DockerPage.ID then Result := not InstallDocker()
  else if PageID = AssistantPage.ID then Result := not AssistantIntegrationAvailable()
  else if PageID = IntegrationRuntimePage.ID then Result := not (InstallNative() and InstallDocker());
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortValue: Integer;
  ResolvedPort: Integer;
  ReservedPort: Integer;
begin
  Result := True;

  if (CurPageID = NativeOptionsPage.ID) and InstallNative() then
  begin
    if not (NativeOptionsPage.Values[0] or NativeOptionsPage.Values[1] or NativeOptionsPage.Values[2]) then
    begin
      MsgBox('Sélectionnez au moins une surface native.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = RuntimePage.ID then
  begin
    if Trim(RuntimePage.Values[0]) = '' then
    begin
      MsgBox('NEXUS_HOME ne peut pas être vide.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(RuntimePage.Values[2], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST natif doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if InstallNativeRest() then
    begin
      if not IsSafeBindAddress(RuntimePage.Values[1]) then
      begin
        MsgBox('L''adresse d''écoute REST native est vide ou invalide.', mbError, MB_OK);
        Result := False;
        exit;
      end;
      ResolvedPort := FindAvailableTcpPort(RuntimePage.Values[1], PortValue, -1);
      if ResolvedPort < 1 then
      begin
        MsgBox('Aucun port TCP disponible n''a été trouvé pour le REST natif.', mbError, MB_OK);
        Result := False;
        exit;
      end;
      RuntimePage.Values[2] := IntToStr(ResolvedPort);
      NotifyPortSelection('Le port REST natif', PortValue, ResolvedPort);
    end;
    if InstallNativeRest() and (Lowercase(Trim(RuntimePage.Values[1])) <> '127.0.0.1') and (Lowercase(Trim(RuntimePage.Values[1])) <> 'localhost') and (Trim(RuntimePage.Values[3]) = '') then
    begin
      MsgBox('Un token API REST est obligatoire pour une écoute native non-loopback.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if (CurPageID = OllamaPage.ID) and OllamaEnabled() and (Trim(OllamaPage.Values[0]) = '') then
  begin
    MsgBox('L''URL Ollama ne peut pas être vide lorsque Ollama est activé.', mbError, MB_OK);
    Result := False;
    exit;
  end;

  if (CurPageID = DockerPrereqPage.ID) and InstallDocker() and not DockerRuntimePresent() and not DockerPrereqPage.Values[0] then
  begin
    MsgBox('Docker Desktop/CLI n''est pas installé. Cochez l''installation automatique ou installez Docker avant de continuer.', mbError, MB_OK);
    Result := False;
    exit;
  end;

  if CurPageID = DockerPage.ID then
  begin
    if (not DockerRuntimePresent()) and (not DockerDesktopAutoInstallSelected()) then
    begin
      MsgBox('Docker Desktop/CLI n''est pas disponible et son installation automatique n''est pas sélectionnée.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if (Trim(DockerPage.Values[0]) = '') or (Trim(DockerPage.Values[1]) = '') or (Trim(DockerPage.Values[5]) = '') then
    begin
      MsgBox('Image, nom du conteneur et repository Docker sont obligatoires.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsSafeBindAddress(DockerPage.Values[2]) then
    begin
      MsgBox('L''adresse d''écoute hôte Docker est vide ou invalide.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(DockerPage.Values[3], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST hôte Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    ReservedPort := -1;
    if InstallNativeRest() then
      ReservedPort := StrToIntDef(RuntimePage.Values[2], -1);
    ResolvedPort := FindAvailableTcpPort(DockerPage.Values[2], PortValue, ReservedPort);
    if ResolvedPort < 1 then
    begin
      MsgBox('Aucun port TCP disponible n''a été trouvé pour le REST Docker.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    DockerPage.Values[3] := IntToStr(ResolvedPort);
    if (ReservedPort = PortValue) and (ResolvedPort <> PortValue) then
      MsgBox(
        'Le port REST hôte Docker ' + IntToStr(PortValue) + ' est déjà réservé au REST natif NEXUS.' + #13#10 +
        'NEXUS utilisera le port TCP disponible ' + IntToStr(ResolvedPort) + ' pour Docker.',
        mbInformation, MB_OK)
    else
      NotifyPortSelection('Le port REST hôte Docker', PortValue, ResolvedPort);

    PortValue := StrToIntDef(DockerPage.Values[4], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST interne Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  NeedsRestart := False;
  Result := InstallDockerDesktopIfNeeded();
end;

procedure WriteNativeConfiguration;
var
  Content: String;
begin
  if not InstallNative() then exit;
  ForceDirectories(ExpandConstant('{app}\config'));
  Content := '@echo off' + #13#10 +
    'set "NEXUS_HOME=' + RuntimePage.Values[0] + '"' + #13#10 +
    'set "NEXUS_REST_HOST=' + RuntimePage.Values[1] + '"' + #13#10 +
    'set "NEXUS_REST_PORT=' + RuntimePage.Values[2] + '"' + #13#10 +
    'set "NEXUS_REST_API_TOKEN=' + RuntimePage.Values[3] + '"' + #13#10 +
    'set "NEXUS_SEMANTIC_PROVIDER=' + SemanticProviderValue() + '"' + #13#10 +
    'set "NEXUS_OLLAMA_BASE_URL=' + OllamaPage.Values[0] + '"' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\config\nexus-native.env.cmd'), Content, False);
end;

procedure WriteDockerConfiguration;
var
  EnvContent: String;
  ComposeTemplate: AnsiString;
  DockerToken: String;
  UpScript: String;
  DownScript: String;
begin
  if not InstallDocker() then exit;
  ForceDirectories(ExpandConstant('{app}\docker'));
  DockerToken := RuntimePage.Values[3];
  if Trim(DockerToken) = '' then DockerToken := GenerateLocalToken();

  EnvContent :=
    'NEXUS_DOCKER_IMAGE=' + DockerPage.Values[0] + #13#10 +
    'NEXUS_DOCKER_CONTAINER=' + DockerPage.Values[1] + #13#10 +
    'NEXUS_DOCKER_RESTART_POLICY=' + DockerPage.Values[6] + #13#10 +
    'NEXUS_DOCKER_BIND_ADDRESS=' + DockerPage.Values[2] + #13#10 +
    'NEXUS_DOCKER_HOST_PORT=' + DockerPage.Values[3] + #13#10 +
    'NEXUS_DOCKER_CONTAINER_PORT=' + DockerPage.Values[4] + #13#10 +
    'NEXUS_HOME_BIND=' + DockerPath(RuntimePage.Values[0]) + #13#10 +
    'NEXUS_REPOSITORY_BIND=' + DockerPath(DockerPage.Values[5]) + #13#10 +
    'NEXUS_SEMANTIC_PROVIDER=' + SemanticProviderValue() + #13#10 +
    'NEXUS_OLLAMA_BASE_URL=' + OllamaPage.Values[0] + #13#10 +
    'NEXUS_REST_API_TOKEN=' + DockerToken + #13#10;
  SaveStringToFile(ExpandConstant('{app}\docker\.env'), EnvContent, False);

  if not LoadStringFromFile(ExpandConstant('{app}\docker\docker-compose.yml.template'), ComposeTemplate) then
    RaiseException('Impossible de lire la template Docker Compose installée.');
  SaveStringToFile(ExpandConstant('{app}\docker\docker-compose.yml'), ComposeTemplate, False);

  UpScript := '@echo off' + #13#10 +
    'setlocal EnableExtensions' + #13#10 +
    'set "DOCKER_EXE=docker"' + #13#10 +
    'where docker >nul 2>nul || (' + #13#10 +
    '  if exist "%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe" set "DOCKER_EXE=%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe"' + #13#10 +
    '  if exist "%ProgramFiles%\Docker\Docker\resources\bin\docker.exe" set "DOCKER_EXE=%ProgramFiles%\Docker\Docker\resources\bin\docker.exe"' + #13#10 +
    ')' + #13#10 +
    '"%DOCKER_EXE%" info >nul 2>nul && goto docker_ready' + #13#10 +
    'if exist "%LOCALAPPDATA%\Programs\DockerDesktop\Docker Desktop.exe" start "" "%LOCALAPPDATA%\Programs\DockerDesktop\Docker Desktop.exe"' + #13#10 +
    'if exist "%ProgramFiles%\Docker\Docker\Docker Desktop.exe" start "" "%ProgramFiles%\Docker\Docker\Docker Desktop.exe"' + #13#10 +
    'for /L %%I in (1,1,90) do (' + #13#10 +
    '  "%DOCKER_EXE%" info >nul 2>nul && goto docker_ready' + #13#10 +
    '  timeout /t 2 /nobreak >nul' + #13#10 +
    ')' + #13#10 +
    'echo Docker Desktop n''est pas prêt. Acceptez les conditions Docker ou terminez la configuration WSL 2 puis relancez nexus-docker-up.cmd.' + #13#10 +
    'exit /b 30' + #13#10 +
    ':docker_ready' + #13#10 +
    '"%DOCKER_EXE%" compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" up -d' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  DownScript := '@echo off' + #13#10 +
    'setlocal EnableExtensions' + #13#10 +
    'set "DOCKER_EXE=docker"' + #13#10 +
    'where docker >nul 2>nul || (' + #13#10 +
    '  if exist "%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe" set "DOCKER_EXE=%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe"' + #13#10 +
    '  if exist "%ProgramFiles%\Docker\Docker\resources\bin\docker.exe" set "DOCKER_EXE=%ProgramFiles%\Docker\Docker\resources\bin\docker.exe"' + #13#10 +
    ')' + #13#10 +
    '"%DOCKER_EXE%" compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" down' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-up.cmd'), UpScript, False);
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-down.cmd'), DownScript, False);

  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', '1');
end;

function NativeMcpCommandJson(ServersKey: String): String;
var
  JavaPath: String;
  RunnerPath: String;
begin
  JavaPath := JsonEscape(ExpandConstant('{app}\app\runtime\bin\java.exe'));
  RunnerPath := JsonEscape(ExpandConstant('{app}\lib\nexus-mcp.jar'));
  Result := '{' + #13#10 +
    '  "' + ServersKey + '": {' + #13#10 +
    '    "nexus": {' + #13#10 +
    '      "type": "stdio",' + #13#10 +
    '      "command": "' + JavaPath + '",' + #13#10 +
    '      "args": ["-jar", "' + RunnerPath + '"]' + #13#10 +
    '    }' + #13#10 +
    '  }' + #13#10 +
    '}' + #13#10;
end;

function DockerMcpCommandJson(ServersKey: String): String;
begin
  Result := '{' + #13#10 +
    '  "' + ServersKey + '": {' + #13#10 +
    '    "nexus": {' + #13#10 +
    '      "type": "stdio",' + #13#10 +
    '      "command": "docker",' + #13#10 +
    '      "args": ["exec", "-i", "' + JsonEscape(DockerPage.Values[1]) + '", "java", "-jar", "/opt/nexus/lib/nexus-mcp.jar"]' + #13#10 +
    '    }' + #13#10 +
    '  }' + #13#10 +
    '}' + #13#10;
end;

function NativeCodexToml(): String;
var
  JavaPath: String;
  RunnerPath: String;
begin
  JavaPath := TomlEscape(ExpandConstant('{app}\app\runtime\bin\java.exe'));
  RunnerPath := TomlEscape(ExpandConstant('{app}\lib\nexus-mcp.jar'));
  Result := '[mcp_servers.nexus]' + #13#10 +
    'command = "' + JavaPath + '"' + #13#10 +
    'args = ["-jar", "' + RunnerPath + '"]' + #13#10;
end;

function DockerCodexToml(): String;
begin
  Result := '[mcp_servers.nexus]' + #13#10 +
    'command = "docker"' + #13#10 +
    'args = ["exec", "-i", "' + TomlEscape(DockerPage.Values[1]) + '", "java", "-jar", "/opt/nexus/lib/nexus-mcp.jar"]' + #13#10;
end;

procedure WriteAssistantAssets;
var
  Dir: String;
  CopilotScript: String;
  ClaudeScript: String;
  CodexScript: String;
  CommandTail: String;
begin
  if not HasAssistantSelection() then exit;
  Dir := ExpandConstant('{app}\integrations');
  ForceDirectories(Dir);

  if UseDockerForIntegrations() then
    CommandTail := 'docker exec -i "' + DockerPage.Values[1] + '" java -jar /opt/nexus/lib/nexus-mcp.jar'
  else
    CommandTail := '"' + ExpandConstant('{app}\app\runtime\bin\java.exe') + '" -jar "' + ExpandConstant('{app}\lib\nexus-mcp.jar') + '"';

  if AssistantPage.Values[1] then
  begin
    if UseDockerForIntegrations() then
      SaveStringToFile(Dir + '\copilot-jetbrains.mcp.json', DockerMcpCommandJson('servers'), False)
    else
      SaveStringToFile(Dir + '\copilot-jetbrains.mcp.json', NativeMcpCommandJson('servers'), False);
  end;

  if AssistantPage.Values[3] then
  begin
    if UseDockerForIntegrations() then
      SaveStringToFile(Dir + '\codex-desktop.mcp.toml', DockerCodexToml(), False)
    else
      SaveStringToFile(Dir + '\codex-desktop.mcp.toml', NativeCodexToml(), False);
  end;

  if AssistantPage.Values[4] then
  begin
    if UseDockerForIntegrations() then
      SaveStringToFile(Dir + '\generic-mcp.json', DockerMcpCommandJson('mcpServers'), False)
    else
      SaveStringToFile(Dir + '\generic-mcp.json', NativeMcpCommandJson('mcpServers'), False);
  end;

  if AssistantPage.Values[0] then
  begin
    CopilotScript := '@echo off' + #13#10 +
      'where copilot >nul 2>nul || exit /b 10' + #13#10 +
      'copilot mcp get nexus >nul 2>nul && exit /b 20' + #13#10 +
      'copilot mcp add nexus --tools "*" -- ' + CommandTail + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-copilot-cli.cmd', CopilotScript, False);
  end;

  if AssistantPage.Values[2] then
  begin
    ClaudeScript := '@echo off' + #13#10 +
      'where claude >nul 2>nul || exit /b 10' + #13#10 +
      'claude mcp get nexus >nul 2>nul && exit /b 20' + #13#10 +
      'claude mcp add --scope user nexus -- ' + CommandTail + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-claude-cli.cmd', ClaudeScript, False);
  end;

  if AssistantPage.Values[3] then
  begin
    CodexScript := '@echo off' + #13#10 +
      'where codex >nul 2>nul || exit /b 10' + #13#10 +
      'set "CODEX_CONFIG=%USERPROFILE%\.codex\config.toml"' + #13#10 +
      'if not exist "%CODEX_CONFIG%" goto codex_add_nexus' + #13#10 +
      'findstr /R /C:"^\[mcp_servers\.nexus\]" "%CODEX_CONFIG%" >nul 2>nul && exit /b 20' + #13#10 +
      ':codex_add_nexus' + #13#10 +
      'codex mcp add nexus -- ' + CommandTail + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-codex-desktop.cmd', CodexScript, False);
  end;
end;

procedure RunManagedIntegration(ScriptName: String; RegistryName: String);
var
  ResultCode: Integer;
  ScriptPath: String;
begin
  ScriptPath := ExpandConstant('{app}\integrations\') + ScriptName;
  if not FileExists(ScriptPath) then exit;
  if Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ScriptPath + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    if ResultCode = 0 then RegWriteStringValue(HKCU, InstallerRegistryPath(), RegistryName, '1')
    else if ResultCode = 20 then Log(ScriptName + ': existing NEXUS MCP entry preserved')
    else if ResultCode = 10 then Log(ScriptName + ': client CLI not detected; generated integration asset kept for later')
    else Log(ScriptName + ': integration command exited with code ' + IntToStr(ResultCode));
  end;
end;

procedure PersistSettings;
begin
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', DeploymentPage.SelectedValueIndex);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', RuntimePage.Values[0]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', RuntimePage.Values[1]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', RuntimePage.Values[2]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', RuntimePage.Values[3]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', SemanticProviderValue());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', OllamaPage.Values[0]);
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'DockerAutoInstall', Ord(DockerPrereqPage.Values[0]));
  if InstallDocker() then
  begin
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', DockerPage.Values[0]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', DockerPage.Values[1]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', DockerPage.Values[2]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', DockerPage.Values[3]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', DockerPage.Values[4]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', DockerPage.Values[5]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', DockerPage.Values[6]);
  end;
end;

function DeploymentModeLabel(): String;
begin
  if DeploymentPage.SelectedValueIndex = 0 then Result := 'Natif Windows'
  else if DeploymentPage.SelectedValueIndex = 1 then Result := 'Docker'
  else Result := 'Natif + Docker';
end;

function ProfileLabel(): String;
begin
  if IsCustomProfile() then Result := 'Personnalisé' else Result := 'Recommandé';
end;

function IntegrationRuntimeLabel(): String;
begin
  if UseDockerForIntegrations() then Result := 'Docker / docker exec -i'
  else Result := 'Natif / Java embarqué';
end;

function DockerPrerequisiteSummary(NewLine: String): String;
begin
  Result := '';
  if not InstallDocker() then exit;
  if DockerRuntimePresent() then
    Result := '  - Docker Desktop/CLI : détecté' + NewLine
  else if DockerDesktopAutoInstallSelected() then
    Result := '  - Docker Desktop : sera téléchargé depuis desktop.docker.com et installé en mode utilisateur (WSL 2)' + NewLine +
      '  - La licence Docker devra être acceptée par l''utilisateur au premier démarrage ; NEXUS ne l''accepte pas automatiquement.' + NewLine
  else
    Result := '  - Docker Desktop/CLI : absent' + NewLine;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo, MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := 'RÉCAPITULATIF NEXUS' + NewLine + NewLine +
    'Mode : ' + DeploymentModeLabel() + NewLine +
    'Profil : ' + ProfileLabel() + NewLine +
    'Répertoire : ' + WizardDirValue() + NewLine +
    'NEXUS_HOME : ' + RuntimePage.Values[0] + NewLine;

  if InstallNative() then
  begin
    Result := Result + NewLine + 'Natif :' + NewLine;
    if InstallNativeCli() then Result := Result + '  - CLI NEXUS' + NewLine;
    if InstallNativeMcp() then Result := Result + '  - Serveur MCP STDIO' + NewLine;
    if InstallNativeRest() then Result := Result + '  - REST ' + RuntimePage.Values[1] + ':' + RuntimePage.Values[2] + ' (port externe vérifié)' + NewLine;
    if WizardIsTaskSelected('addtopath') then Result := Result + '  - Ajouter NEXUS au PATH utilisateur' + NewLine;
  end;

  if OllamaEnabled() then
    Result := Result + NewLine + 'Recherche sémantique : Ollama ACTIVÉ' + NewLine +
      '  - URL : ' + OllamaPage.Values[0] + NewLine +
      '  - Le setup configure NEXUS mais n''installe pas le binaire Ollama.' + NewLine
  else
    Result := Result + NewLine + 'Recherche sémantique : désactivée' + NewLine;

  if InstallDocker() then
  begin
    Result := Result + NewLine + 'Docker :' + NewLine + DockerPrerequisiteSummary(NewLine) +
      '  - Image : ' + DockerPage.Values[0] + NewLine +
      '  - Conteneur : ' + DockerPage.Values[1] + NewLine +
      '  - REST : ' + DockerPage.Values[2] + ':' + DockerPage.Values[3] + ' (port hôte vérifié) -> conteneur:' + DockerPage.Values[4] + NewLine +
      '  - Repository : ' + DockerPage.Values[5] + ' -> /workspace:ro' + NewLine +
      '  - Restart policy : ' + DockerPage.Values[6] + NewLine;
    if WizardIsTaskSelected('startdocker') then Result := Result + '  - Démarrage Docker après installation' + NewLine;
  end;

  Result := Result + NewLine + 'Assistants MCP :' + NewLine;
  if HasAssistantSelection() then
  begin
    if AssistantPage.Values[0] then Result := Result + '  - GitHub Copilot CLI' + NewLine;
    if AssistantPage.Values[1] then Result := Result + '  - GitHub Copilot JetBrains' + NewLine;
    if AssistantPage.Values[2] then Result := Result + '  - Claude CLI / Claude Code' + NewLine;
    if AssistantPage.Values[3] then Result := Result + '  - Codex Desktop' + NewLine;
    if AssistantPage.Values[4] then Result := Result + '  - Client MCP générique' + NewLine;
    Result := Result + '  - Runtime MCP : ' + IntegrationRuntimeLabel() + NewLine;
  end
  else
    Result := Result + '  - Aucune intégration sélectionnée' + NewLine;

  Result := Result + NewLine + 'Cliquez sur Installer pour appliquer exactement cette configuration.';
end;

procedure StartDockerDesktopAfterInstall;
var
  DockerDesktopPath: String;
  ResultCode: Integer;
begin
  if not DockerDesktopInstalledDuringSetup then exit;
  DockerDesktopPath := DockerDesktopExecutable();
  if DockerDesktopPath = '' then exit;
  if Exec(DockerDesktopPath, '', '', SW_SHOWNORMAL, ewNoWait, ResultCode) then
    MsgBox(
      'Docker Desktop a été installé et vient d''être lancé.' + #13#10 +
      'Au premier démarrage, acceptez les conditions Docker et terminez si nécessaire la préparation WSL 2. ' +
      'Le script NEXUS Docker attendra ensuite que le moteur soit prêt.',
      mbInformation, MB_OK);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    WriteNativeConfiguration;
    WriteDockerConfiguration;
    WriteAssistantAssets;
    AddNexusToUserPath;
    PersistSettings;
    StartDockerDesktopAfterInstall;
    if (not IsSmokeBuild()) and HasAssistantSelection() then
    begin
      if AssistantPage.Values[0] then RunManagedIntegration('connect-copilot-cli.cmd', 'CopilotCliManaged');
      if AssistantPage.Values[2] then RunManagedIntegration('connect-claude-cli.cmd', 'ClaudeCliManaged');
      if AssistantPage.Values[3] then RunManagedIntegration('connect-codex-desktop.cmd', 'CodexManaged');
    end;
  end;
end;

procedure RemoveManagedAssistantIntegrations;
var
  Value: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged', Value) and (Value = '1') and CommandExists('copilot') then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C "copilot mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ClaudeCliManaged', Value) and (Value = '1') and CommandExists('claude') then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C "claude mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ClaudeCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CodexManaged', Value) and (Value = '1') and CommandExists('codex') then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C "codex mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CodexManaged');
  end;
end;

procedure StopManagedDocker;
var
  Value: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', Value) and (Value = '1') and FileExists(ExpandConstant('{app}\nexus-docker-down.cmd')) then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ExpandConstant('{app}\nexus-docker-down.cmd') + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'DockerManaged');
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    StopManagedDocker;
    RemoveManagedAssistantIntegrations;
    RemoveNexusFromUserPath;
    { NEXUS_HOME and Docker Desktop are intentionally preserved. }
  end;
end;