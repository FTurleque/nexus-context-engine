procedure CreateClientRow(Index: Integer; Top: Integer);
begin
  ClientBoxes[Index] := TNewCheckBox.Create(AssistantPage);
  ClientBoxes[Index].Parent := AssistantPage.Surface;
  ClientBoxes[Index].Left := 0;
  ClientBoxes[Index].Top := Top;
  ClientBoxes[Index].Width := AssistantPage.SurfaceWidth;
  ClientBoxes[Index].Caption := ClientLabel(Index);
  ClientBoxes[Index].Checked := False;
  ClientStatus[Index] := TNewStaticText.Create(AssistantPage);
  ClientStatus[Index].Parent := AssistantPage.Surface;
  ClientStatus[Index].Left := ScaleX(18);
  ClientStatus[Index].Top := Top + ScaleY(17);
  ClientStatus[Index].Width := AssistantPage.SurfaceWidth - ScaleX(18);
  ClientStatus[Index].AutoSize := False;
  ClientStatus[Index].Height := ScaleY(15);
  ClientStatus[Index].Font.Color := clGray;
  ClientConfigured[Index] := False;
  ClientOwned[Index] := False;
end;

procedure CreateAssistantPage;
var
  I: Integer;
begin
  AssistantPage := CreateCustomPage(DockerPage.ID,
    'Clients IA',
    'Connecter le serveur MCP NEXUS aux clients IA détectés. Une entrée "nexus" existante n''est jamais écrasée.');
  SetArrayLength(ClientBoxes, CLIENT_COUNT);
  SetArrayLength(ClientStatus, CLIENT_COUNT);
  SetArrayLength(ClientConfigured, CLIENT_COUNT);
  SetArrayLength(ClientOwned, CLIENT_COUNT);
  for I := 0 to CLIENT_COUNT - 1 do
    CreateClientRow(I, ScaleY(2) + I * ScaleY(35));
  ClientBoxes[CLIENT_CODEX_CLI].OnClick := @CodexCliClick;
  ClientBoxes[CLIENT_CODEX_DESKTOP].OnClick := @CodexDesktopClick;
  for I := 0 to CLIENT_GENERIC - 1 do
  begin
    ClientBoxes[I].Enabled := False;
    ClientStatus[I].Caption := 'Détection en attente';
  end;
  ClientStatus[CLIENT_GENERIC].Caption := 'Toujours disponible — fichier JSON STDIO à importer manuellement';
  ClientPreflightDone := False;
end;

{ Without a usable preflight, every row stays selectable as before: the connect
  scripts still check for the client and keep the generated asset when it is absent. }
procedure EnableClientRowsWithoutDetection(Reason: String);
var
  I: Integer;
begin
  for I := 0 to CLIENT_GENERIC - 1 do
  begin
    ClientBoxes[I].Enabled := True;
    ClientStatus[I].Caption := Reason;
  end;
end;

procedure ApplyClientPreflight(Ini: String);
var
  I: Integer;
  Available: Boolean;
  Configured: Boolean;
  Reason: String;
begin
  for I := 0 to CLIENT_GENERIC - 1 do
  begin
    Available := GetIniString(ClientSection(I), 'Available', '0', Ini) = '1';
    Configured := GetIniString(ClientSection(I), 'Configured', '0', Ini) = '1';
    Reason := GetIniString(ClientSection(I), 'Reason', 'Détection indisponible', Ini);
    ClientConfigured[I] := Available and Configured;
    ClientOwned[I] := ClientConfigured[I] and (GetIniString(ClientSection(I), 'Owned', '0', Ini) = '1');
    { A connected client is shown ticked and locked: there is nothing left to do. }
    ClientBoxes[I].Enabled := Available and (not Configured);
    ClientBoxes[I].Checked := Available and Configured;
    if Available and Configured then
      ClientStatus[I].Caption := Reason + ' — déjà configuré'
    else
      ClientStatus[I].Caption := Reason;
  end;
end;

procedure RunClientPreflight;
var
  Ini: String;
  Detector: String;
  ResultCode: Integer;
  I: Integer;
begin
  ClientPreflightDone := True;
  for I := 0 to CLIENT_GENERIC - 1 do ClientStatus[I].Caption := 'Détection en cours…';
  WizardForm.Repaint;
  Ini := ExpandConstant('{tmp}\nexus-client-preflight.ini');
  DeleteFile(Ini);
  try
    ExtractTemporaryFile('detect-assistant-clients.ps1');
  except
    EnableClientRowsWithoutDetection('Détection indisponible — la connexion sera tentée à l''installation');
    exit;
  end;
  Detector := ExpandConstant('{tmp}\detect-assistant-clients.ps1');
  if (not Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + Detector + '" -OutputPath "' + Ini + '"',
      '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) or (not FileExists(Ini)) then
  begin
    Log('Assistant client preflight failed with exit code ' + IntToStr(ResultCode));
    EnableClientRowsWithoutDetection('Détection indisponible — la connexion sera tentée à l''installation');
    exit;
  end;
  ApplyClientPreflight(Ini);
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if (CurPageID = AssistantPage.ID) and (not ClientPreflightDone) and (not IsSmokeBuild()) then
    RunClientPreflight;
end;

