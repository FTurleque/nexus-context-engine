[Code]
var
  DeploymentPage: TInputOptionWizardPage;
  ProfilePage: TInputOptionWizardPage;
  NativeOptionsPage: TInputOptionWizardPage;
  RuntimePage: TInputQueryWizardPage;
  SemanticPage: TInputOptionWizardPage;
  OllamaPage: TInputQueryWizardPage;
  DockerPrereqPage: TInputOptionWizardPage;
  DockerPage: TInputQueryWizardPage;
  AssistantPage: TInputOptionWizardPage;
  IntegrationRuntimePage: TInputOptionWizardPage;
  DockerDesktopInstalledDuringSetup: Boolean;

function IsSmokeBuild(): Boolean;
begin
  Result := {#NexusSmokeMode} = 1;
end;

function InstallerRegistryPath(): String;
begin
  Result := 'Software\FTurleque\NEXUS';
end;

function InstallNative(): Boolean;
begin
  Result := (DeploymentPage.SelectedValueIndex = 0) or (DeploymentPage.SelectedValueIndex = 2);
end;

function InstallDocker(): Boolean;
begin
  Result := (not IsSmokeBuild()) and ((DeploymentPage.SelectedValueIndex = 1) or (DeploymentPage.SelectedValueIndex = 2));
end;

function IsCustomProfile(): Boolean;
begin
  Result := ProfilePage.SelectedValueIndex = 1;
end;

function InstallNativeCli(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[0];
end;

function InstallNativeMcp(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[1];
end;

function InstallNativeRest(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[2];
end;

function OllamaEnabled(): Boolean;
begin
  Result := SemanticPage.Values[0];
end;

function SemanticProviderValue(): String;
begin
  if OllamaEnabled() then
    Result := 'ollama'
  else
    Result := '';
end;

function AssistantIntegrationAvailable(): Boolean;
begin
  Result := InstallNativeMcp() or InstallDocker();
end;

function HasAssistantSelection(): Boolean;
begin
  Result := AssistantIntegrationAvailable() and
    (AssistantPage.Values[0] or AssistantPage.Values[1] or AssistantPage.Values[2] or AssistantPage.Values[3] or AssistantPage.Values[4]);
end;

function UseDockerForIntegrations(): Boolean;
begin
  if InstallDocker() and not InstallNative() then
    Result := True
  else if InstallDocker() and InstallNative() then
    Result := IntegrationRuntimePage.SelectedValueIndex = 1
  else
    Result := False;
end;

function TrimTrailingBackslash(Value: String): String;
begin
  Result := Value;
  while (Length(Result) > 3) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function JsonEscape(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function TomlEscape(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function DockerPath(Value: String): String;
begin
  Result := TrimTrailingBackslash(Value);
  StringChangeEx(Result, '\', '/', True);
end;

function PathContainsEntry(PathValue: String; Entry: String): Boolean;
var
  Haystack: String;
  Needle: String;
begin
  Haystack := ';' + Lowercase(PathValue) + ';';
  Needle := ';' + Lowercase(TrimTrailingBackslash(Entry)) + ';';
  Result := Pos(Needle, Haystack) > 0;
end;

function CommandExists(Name: String): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/D /S /C "where ' + Name + ' >nul 2>nul"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function DockerDesktopExecutable(): String;
var
  Candidate: String;
begin
  Result := '';
  Candidate := GetEnv('LOCALAPPDATA') + '\Programs\DockerDesktop\Docker Desktop.exe';
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    exit;
  end;
  Candidate := ExpandConstant('{autopf}\Docker\Docker\Docker Desktop.exe');
  if FileExists(Candidate) then Result := Candidate;
end;

function DockerCliExecutable(): String;
var
  Candidate: String;
begin
  Result := '';
  if CommandExists('docker') then
  begin
    Result := 'docker';
    exit;
  end;
  Candidate := GetEnv('LOCALAPPDATA') + '\Programs\DockerDesktop\resources\bin\docker.exe';
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    exit;
  end;
  Candidate := ExpandConstant('{autopf}\Docker\Docker\resources\bin\docker.exe');
  if FileExists(Candidate) then Result := Candidate;
end;

function DockerRuntimePresent(): Boolean;
begin
  Result := (DockerCliExecutable() <> '') or (DockerDesktopExecutable() <> '');
end;

function DockerDesktopAutoInstallSelected(): Boolean;
begin
  Result := InstallDocker() and DockerPrereqPage.Values[0];
end;

function PowerShellSingleQuote(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '''', '''''', True);
end;

function VerifyDockerDesktopInstaller(InstallerPath: String): Boolean;
var
  PowerShellPath: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := False;
  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellPath) then exit;
  Script :=
    '$s=Get-AuthenticodeSignature -LiteralPath ''' + PowerShellSingleQuote(InstallerPath) + '''; ' +
    'if (($s.Status -eq ''Valid'') -and ($null -ne $s.SignerCertificate) -and ' +
    '($s.SignerCertificate.Subject -match ''(^|,\s*)CN=Docker Inc(,|$)'')) { exit 0 } else { exit 1 }';
  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';
  Result := Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function InstallDockerDesktopIfNeeded(): String;
var
  InstallerPath: String;
  ResultCode: Integer;
  DownloadedSize: Int64;
begin
  Result := '';
  if not InstallDocker() or DockerRuntimePresent() then exit;
  if not DockerDesktopAutoInstallSelected() then
  begin
    Result := 'Docker Desktop/CLI est absent et son installation automatique est désactivée.';
    exit;
  end;

  try
    DownloadedSize := DownloadTemporaryFile(
      'https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe',
      'NEXUS-Docker-Desktop-Installer.exe', '', nil);
    Log('Docker Desktop téléchargé : ' + IntToStr(DownloadedSize) + ' octets.');
  except
    Result := 'Impossible de télécharger Docker Desktop depuis le domaine officiel Docker : ' + GetExceptionMessage;
    exit;
  end;

  InstallerPath := ExpandConstant('{tmp}\NEXUS-Docker-Desktop-Installer.exe');
  if not FileExists(InstallerPath) then
  begin
    Result := 'Le téléchargement Docker Desktop n''a pas produit le fichier attendu.';
    exit;
  end;
  if not VerifyDockerDesktopInstaller(InstallerPath) then
  begin
    Result := 'La signature Authenticode de Docker Desktop est invalide ou le signataire n''est pas Docker Inc. Installation annulée.';
    exit;
  end;

  if not Exec(InstallerPath, 'install --user --backend=wsl-2 --quiet', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
  begin
    Result := 'L''installation Docker Desktop a échoué avec le code ' + IntToStr(ResultCode) + '.';
    exit;
  end;

  if not DockerRuntimePresent() then
  begin
    Result := 'Docker Desktop a terminé son installation mais aucun runtime Docker n''a été détecté.';
    exit;
  end;

  DockerDesktopInstalledDuringSetup := True;
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerDesktopInstalledByNexus', '1');
end;

function IsSafeBindAddress(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Value := Trim(Value);
  Result := Value <> '';
  if not Result then exit;

  for I := 1 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'a') and (C <= 'z')) or
            ((C >= 'A') and (C <= 'Z')) or
            ((C >= '0') and (C <= '9')) or
            (C = '.') or (C = ':') or (C = '-')) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function IsTcpPortAvailable(BindAddress: String; Port: Integer): Boolean;
var
  PowerShellPath: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := False;
  BindAddress := Trim(BindAddress);
  if (Port < 1) or (Port > 65535) or not IsSafeBindAddress(BindAddress) then exit;

  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellPath) then
  begin
    Log('PowerShell Windows introuvable pour le test de disponibilité du port.');
    exit;
  end;

  Script :=
    '$ErrorActionPreference=''Stop''; $listener=$null; try { ' +
    '$address=''' + BindAddress + '''; ' +
    'if ($address -eq ''localhost'') { $address=''127.0.0.1'' }; ' +
    '$ip=$null; if (-not [System.Net.IPAddress]::TryParse($address,[ref]$ip)) { ' +
    '$ip=[System.Net.Dns]::GetHostAddresses($address) | Select-Object -First 1 }; ' +
    'if ($null -eq $ip) { exit 2 }; ' +
    '$listener=[System.Net.Sockets.TcpListener]::new($ip,' + IntToStr(Port) + '); ' +
    '$listener.Start(); $listener.Stop(); exit 0 } catch { ' +
    'if ($null -ne $listener) { try { $listener.Stop() } catch {} }; exit 1 }';
  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';

  Result := Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function FindAvailableTcpPort(BindAddress: String; RequestedPort: Integer; ReservedPort: Integer): Integer;
var
  Candidate: Integer;
begin
  Result := -1;
  if (RequestedPort < 1) or (RequestedPort > 65535) then exit;

  Candidate := RequestedPort;
  while Candidate <= 65535 do
  begin
    if ((ReservedPort < 1) or (Candidate <> ReservedPort)) and IsTcpPortAvailable(BindAddress, Candidate) then
    begin
      Result := Candidate;
      exit;
    end;
    Candidate := Candidate + 1;
  end;

  Candidate := 1024;
  while Candidate < RequestedPort do
  begin
    if ((ReservedPort < 1) or (Candidate <> ReservedPort)) and IsTcpPortAvailable(BindAddress, Candidate) then
    begin
      Result := Candidate;
      exit;
    end;
    Candidate := Candidate + 1;
  end;
end;

procedure NotifyPortSelection(Description: String; RequestedPort: Integer; SelectedPort: Integer);
begin
  if RequestedPort <> SelectedPort then
    MsgBox(
      Description + ' ' + IntToStr(RequestedPort) + ' est déjà utilisé.' + #13#10 +
      'NEXUS a sélectionné automatiquement le premier port TCP disponible : ' + IntToStr(SelectedPort) + '.',
      mbInformation, MB_OK);
end;

function GenerateLocalToken(): String;
var
  I: Integer;
  Chars: String;
begin
  Chars := 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  Result := '';
  for I := 1 to 48 do
    Result := Result + Chars[Random(Length(Chars)) + 1];
end;

procedure AddNexusToUserPath;
var
  CurrentPath: String;
  AppPath: String;
begin
  if IsSmokeBuild() or not InstallNative() or not WizardIsTaskSelected('addtopath') then exit;
  AppPath := TrimTrailingBackslash(ExpandConstant('{app}'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then CurrentPath := '';
  if not PathContainsEntry(CurrentPath, AppPath) then
  begin
    if (CurrentPath <> '') and (CurrentPath[Length(CurrentPath)] <> ';') then CurrentPath := CurrentPath + ';';
    CurrentPath := CurrentPath + AppPath;
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', CurrentPath);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', AppPath);
  end;
end;

procedure RemoveNexusFromUserPath;
var
  CurrentPath: String;
  ManagedPath: String;
  PaddedPath: String;
  Needle: String;
begin
  if IsSmokeBuild() then exit;
  if not RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', ManagedPath) then exit;
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
  begin
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
    exit;
  end;
  PaddedPath := ';' + CurrentPath + ';';
  Needle := ';' + TrimTrailingBackslash(ManagedPath) + ';';
  StringChangeEx(PaddedPath, Needle, ';', True);
  while (Length(PaddedPath) > 0) and (PaddedPath[1] = ';') do Delete(PaddedPath, 1, 1);
  while (Length(PaddedPath) > 0) and (PaddedPath[Length(PaddedPath)] = ';') do Delete(PaddedPath, Length(PaddedPath), 1);
  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', PaddedPath);
  RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
end;

procedure LoadPreviousSettings;
var
  Value: String;
  Mode: Cardinal;
begin
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', Mode) and (Mode <= 2) then
    DeploymentPage.SelectedValueIndex := Mode;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', Value) then RuntimePage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', Value) then RuntimePage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', Value) then RuntimePage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', Value) then RuntimePage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', Value) then SemanticPage.Values[0] := Lowercase(Trim(Value)) = 'ollama';
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', Value) then OllamaPage.Values[0] := Value;
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'DockerAutoInstall', Mode) then DockerPrereqPage.Values[0] := Mode <> 0;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', Value) then DockerPage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', Value) then DockerPage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', Value) then DockerPage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', Value) then DockerPage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', Value) then DockerPage.Values[4] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', Value) then DockerPage.Values[5] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', Value) then DockerPage.Values[6] := Value;
end;

