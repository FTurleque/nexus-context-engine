#define NexusName "NEXUS Context Engine"
#define NexusVersion "@@VERSION@@"
#define NexusAppVersion "@@APP_VERSION@@"
#define NexusAppId "@@APP_ID@@"
#define NexusSmokeMode @@SMOKE_MODE@@
#define NexusSourceDir "@@SOURCE_DIR@@"
#define NexusOutputDir "@@OUTPUT_DIR@@"
#define NexusOutputBaseFilename "@@OUTPUT_BASENAME@@"

[Setup]
AppId={#NexusAppId}
AppName={#NexusName}
AppVersion={#NexusVersion}
AppPublisher=FTurleque
DefaultDirName={localappdata}\Programs\NEXUS
DefaultGroupName=NEXUS
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#NexusOutputDir}
OutputBaseFilename={#NexusOutputBaseFilename}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ChangesEnvironment=yes
SetupLogging=yes
UninstallDisplayName={#NexusName}
VersionInfoVersion={#NexusAppVersion}
VersionInfoCompany=FTurleque
VersionInfoDescription={#NexusName} Windows deployment wizard
VersionInfoProductName={#NexusName}
VersionInfoProductVersion={#NexusAppVersion}
VersionInfoProductTextVersion={#NexusVersion}

[Tasks]
Name: "addtopath"; Description: "Ajouter NEXUS au PATH de l'utilisateur"; GroupDescription: "Intégration Windows :"; Flags: checkedonce; Check: InstallNative
Name: "startdocker"; Description: "Démarrer le déploiement Docker à la fin de l'installation"; GroupDescription: "Docker :"; Flags: checkedonce; Check: InstallDocker

[Files]
Source: "{#NexusSourceDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NexusSourceDir}\THIRD_PARTY_NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NexusSourceDir}\SBOM.cdx.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NexusSourceDir}\VERSION"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NexusSourceDir}\RUNTIME-MODULES.txt"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallNative
Source: "{#NexusSourceDir}\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#NexusSourceDir}\app\*"; DestDir: "{app}\app"; Flags: ignoreversion recursesubdirs createallsubdirs; Check: InstallNative
Source: "{#NexusSourceDir}\lib\*"; DestDir: "{app}\lib"; Flags: ignoreversion recursesubdirs createallsubdirs; Check: InstallNative
Source: "{#NexusSourceDir}\rest\*"; DestDir: "{app}\rest"; Flags: ignoreversion recursesubdirs createallsubdirs; Check: InstallNativeRest
Source: "{#NexusSourceDir}\nexus.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallNativeCli
Source: "{#NexusSourceDir}\nexus-mcp.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallNativeMcp
Source: "{#NexusSourceDir}\nexus-rest.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallNativeRest
Source: "{#NexusSourceDir}\nexus-assistant-clients.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallNative
Source: "{#NexusSourceDir}\nexus-docker.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallDocker
Source: "{#NexusSourceDir}\nexus-docker-mcp.cmd"; DestDir: "{app}"; Flags: ignoreversion; Check: InstallDocker
Source: "{#NexusSourceDir}\docker\docker-compose.yml.template"; DestDir: "{app}\docker"; Flags: ignoreversion; Check: InstallDocker

[Icons]
Name: "{userprograms}\NEXUS\Dossier d'installation NEXUS"; Filename: "{app}"
Name: "{userprograms}\NEXUS\Démarrer NEXUS Docker"; Filename: "{cmd}"; Parameters: "/C ""{app}\nexus-docker-up.cmd"""; WorkingDir: "{app}"; Check: InstallDocker
Name: "{userprograms}\NEXUS\Arrêter NEXUS Docker"; Filename: "{cmd}"; Parameters: "/C ""{app}\nexus-docker-down.cmd"""; WorkingDir: "{app}"; Check: InstallDocker
Name: "{userprograms}\NEXUS\Intégrations assistants"; Filename: "{app}\integrations"; Check: HasAssistantSelection

[Run]
Filename: "{cmd}"; Parameters: "/D /S /C ""{app}\nexus-docker-up.cmd"""; WorkingDir: "{app}"; Description: "Démarrer NEXUS Docker"; Flags: postinstall runhidden skipifsilent; Tasks: startdocker; Check: InstallDocker

[Code]
var
  DeploymentPage: TInputOptionWizardPage;
  ProfilePage: TInputOptionWizardPage;
  NativeOptionsPage: TInputOptionWizardPage;
  RuntimePage: TInputQueryWizardPage;
  DockerPage: TInputQueryWizardPage;
  AssistantPage: TInputOptionWizardPage;
  IntegrationRuntimePage: TInputOptionWizardPage;

function IsSmokeBuild(): Boolean;
begin
  Result := {#NexusSmokeMode} = 1;
end;

function InstallerRegistryPath(): String;
begin
  Result := 'Software\FTurleque\NEXUS';
end;

function InstallNative(): Boolean;
begin
  Result := (DeploymentPage.SelectedValueIndex = 0) or (DeploymentPage.SelectedValueIndex = 2);
end;

function InstallDocker(): Boolean;
begin
  Result := (not IsSmokeBuild()) and ((DeploymentPage.SelectedValueIndex = 1) or (DeploymentPage.SelectedValueIndex = 2));
end;

function IsCustomProfile(): Boolean;
begin
  Result := ProfilePage.SelectedValueIndex = 1;
end;

function InstallNativeCli(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[0];
end;

function InstallNativeMcp(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[1];
end;

function InstallNativeRest(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[2];
end;

function HasAssistantSelection(): Boolean;
begin
  Result := AssistantPage.Values[0] or AssistantPage.Values[1] or AssistantPage.Values[2] or AssistantPage.Values[3];
end;

function UseDockerForIntegrations(): Boolean;
begin
  if InstallDocker() and not InstallNative() then
    Result := True
  else if InstallDocker() and InstallNative() then
    Result := IntegrationRuntimePage.SelectedValueIndex = 1
  else
    Result := False;
end;

function TrimTrailingBackslash(Value: String): String;
begin
  Result := Value;
  while (Length(Result) > 3) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function JsonEscape(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function DockerPath(Value: String): String;
begin
  Result := TrimTrailingBackslash(Value);
  StringChangeEx(Result, '\', '/', True);
end;

function PathContainsEntry(PathValue: String; Entry: String): Boolean;
var
  Haystack: String;
  Needle: String;
begin
  Haystack := ';' + Lowercase(PathValue) + ';';
  Needle := ';' + Lowercase(TrimTrailingBackslash(Entry)) + ';';
  Result := Pos(Needle, Haystack) > 0;
end;

function CommandExists(Name: String): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/D /S /C "where ' + Name + ' >nul 2>nul"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function GenerateLocalToken(): String;
var
  I: Integer;
  Chars: String;
begin
  Chars := 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  Result := '';
  for I := 1 to 48 do
    Result := Result + Chars[Random(Length(Chars)) + 1];
end;

procedure AddNexusToUserPath;
var
  CurrentPath: String;
  AppPath: String;
begin
  if IsSmokeBuild() or not InstallNative() or not WizardIsTaskSelected('addtopath') then exit;
  AppPath := TrimTrailingBackslash(ExpandConstant('{app}'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then CurrentPath := '';
  if not PathContainsEntry(CurrentPath, AppPath) then
  begin
    if (CurrentPath <> '') and (CurrentPath[Length(CurrentPath)] <> ';') then CurrentPath := CurrentPath + ';';
    CurrentPath := CurrentPath + AppPath;
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', CurrentPath);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', AppPath);
  end;
end;

procedure RemoveNexusFromUserPath;
var
  CurrentPath: String;
  ManagedPath: String;
  PaddedPath: String;
  Needle: String;
begin
  if IsSmokeBuild() then exit;
  if not RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', ManagedPath) then exit;
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
  begin
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
    exit;
  end;
  PaddedPath := ';' + CurrentPath + ';';
  Needle := ';' + TrimTrailingBackslash(ManagedPath) + ';';
  StringChangeEx(PaddedPath, Needle, ';', True);
  while (Length(PaddedPath) > 0) and (PaddedPath[1] = ';') do Delete(PaddedPath, 1, 1);
  while (Length(PaddedPath) > 0) and (PaddedPath[Length(PaddedPath)] = ';') do Delete(PaddedPath, Length(PaddedPath), 1);
  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', PaddedPath);
  RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
end;

procedure LoadPreviousSettings;
var
  Value: String;
  Mode: Cardinal;
begin
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', Mode) and (Mode <= 2) then
    DeploymentPage.SelectedValueIndex := Mode;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', Value) then RuntimePage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', Value) then RuntimePage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', Value) then RuntimePage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', Value) then RuntimePage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', Value) then RuntimePage.Values[4] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', Value) then RuntimePage.Values[5] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', Value) then DockerPage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', Value) then DockerPage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', Value) then DockerPage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', Value) then DockerPage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', Value) then DockerPage.Values[4] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', Value) then DockerPage.Values[5] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', Value) then DockerPage.Values[6] := Value;
end;

procedure InitializeWizard;
begin
  DeploymentPage := CreateInputOptionPage(wpSelectDir,
    'Mode de déploiement',
    'Choisissez comment exécuter NEXUS.',
    'Le mode natif ne nécessite ni Docker ni JVM système. Le mode Docker nécessite Docker Desktop/Engine. Vous pouvez installer les deux.',
    True, False);
  DeploymentPage.Add('Natif Windows — recommandé pour MCP local');
  DeploymentPage.Add('Docker — conteneur avec volumes et port REST configurable');
  DeploymentPage.Add('Natif + Docker — installer les deux modes');
  DeploymentPage.SelectedValueIndex := 0;

  ProfilePage := CreateInputOptionPage(DeploymentPage.ID,
    'Profil d''installation',
    'Choisissez le niveau de personnalisation.',
    'Le profil recommandé applique les valeurs sûres par défaut. Le profil personnalisé expose les composants, ports, volumes et options runtime.',
    True, False);
  ProfilePage.Add('Recommandé');
  ProfilePage.Add('Personnalisé');
  ProfilePage.SelectedValueIndex := 0;

  NativeOptionsPage := CreateInputOptionPage(ProfilePage.ID,
    'Composants natifs',
    'Sélectionnez les surfaces NEXUS natives.',
    'Le runtime Java embarqué est partagé. MCP reste en STDIO ; REST est optionnel.',
    False, False);
  NativeOptionsPage.Add('CLI NEXUS');
  NativeOptionsPage.Add('Serveur MCP STDIO');
  NativeOptionsPage.Add('API REST Quarkus');
  NativeOptionsPage.Values[0] := True;
  NativeOptionsPage.Values[1] := True;
  NativeOptionsPage.Values[2] := False;

  RuntimePage := CreateInputQueryPage(NativeOptionsPage.ID,
    'Configuration runtime',
    'Personnalisez le stockage et les services.',
    'NEXUS_HOME est conservé lors de la désinstallation. Un token REST est obligatoire pour une écoute native non-loopback et est généré automatiquement pour Docker si laissé vide.');
  RuntimePage.Add('NEXUS_HOME :', False);
  RuntimePage.Add('REST natif — adresse :', False);
  RuntimePage.Add('REST natif — port :', False);
  RuntimePage.Add('Token API REST (optionnel sur loopback) :', True);
  RuntimePage.Add('Provider sémantique (vide ou ollama) :', False);
  RuntimePage.Add('URL Ollama :', False);
  RuntimePage.Values[0] := GetEnv('USERPROFILE') + '\.nexus';
  RuntimePage.Values[1] := '127.0.0.1';
  RuntimePage.Values[2] := '8080';
  RuntimePage.Values[3] := '';
  RuntimePage.Values[4] := '';
  RuntimePage.Values[5] := 'http://127.0.0.1:11434';

  DockerPage := CreateInputQueryPage(RuntimePage.ID,
    'Configuration Docker',
    'Personnalisez l''image, le conteneur, les ports et le repository monté.',
    'Le port hôte peut être modifié librement. Le port interne reste 8080 par défaut. Le repository est monté en lecture seule sous /workspace.');
  DockerPage.Add('Image :', False);
  DockerPage.Add('Nom du conteneur :', False);
  DockerPage.Add('Adresse d''écoute hôte :', False);
  DockerPage.Add('Port REST hôte :', False);
  DockerPage.Add('Port REST conteneur :', False);
  DockerPage.Add('Repository / racine de projets à monter :', False);
  DockerPage.Add('Restart policy :', False);
  DockerPage.Values[0] := 'ghcr.io/fturleque/nexus-context-engine:{#NexusVersion}';
  DockerPage.Values[1] := 'nexus';
  DockerPage.Values[2] := '127.0.0.1';
  DockerPage.Values[3] := '8080';
  DockerPage.Values[4] := '8080';
  DockerPage.Values[5] := GetEnv('USERPROFILE');
  DockerPage.Values[6] := 'unless-stopped';

  AssistantPage := CreateInputOptionPage(DockerPage.ID,
    'Intégrations assistants IA',
    'Choisissez les clients MCP à préparer ou connecter.',
    'NEXUS ne gère aucune authentification. Les entrées existantes nommées "nexus" ne sont jamais écrasées.',
    False, False);
  AssistantPage.Add('GitHub Copilot CLI — connecter si la CLI est détectée');
  AssistantPage.Add('GitHub Copilot JetBrains — générer un mcp.json prêt à importer');
  AssistantPage.Add('Claude Code — scope utilisateur, connecter si la CLI est détectée');
  AssistantPage.Add('Client MCP générique — générer un JSON STDIO');
  AssistantPage.Values[0] := True;
  AssistantPage.Values[1] := True;
  AssistantPage.Values[2] := True;
  AssistantPage.Values[3] := True;

  IntegrationRuntimePage := CreateInputOptionPage(AssistantPage.ID,
    'Runtime MCP des assistants',
    'NEXUS natif et Docker sont tous les deux installés.',
    'Choisissez le runtime utilisé par les configurations assistants. Cette option n''apparaît qu''en mode Natif + Docker.',
    True, False);
  IntegrationRuntimePage.Add('MCP natif avec Java embarqué');
  IntegrationRuntimePage.Add('MCP Docker via docker exec -i');
  IntegrationRuntimePage.SelectedValueIndex := 0;

  if IsSmokeBuild() then
  begin
    DeploymentPage.SelectedValueIndex := 0;
    ProfilePage.SelectedValueIndex := 0;
    AssistantPage.Values[0] := False;
    AssistantPage.Values[1] := False;
    AssistantPage.Values[2] := False;
    AssistantPage.Values[3] := False;
  end
  else
    LoadPreviousSettings;
