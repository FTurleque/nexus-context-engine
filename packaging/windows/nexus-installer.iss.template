const
  BCRYPT_USE_SYSTEM_PREFERRED_RNG = $00000002;
  { Rows of the "Clients IA" page. ClientSection gives the matching INI section
    written by detect-assistant-clients.ps1. }
  CLIENT_COPILOT_CLI = 0;
  CLIENT_COPILOT_JETBRAINS = 1;
  CLIENT_CLAUDE_CODE = 2;
  CLIENT_CLAUDE_DESKTOP = 3;
  CLIENT_CODEX_CLI = 4;
  CLIENT_CODEX_DESKTOP = 5;
  CLIENT_GENERIC = 6;
  CLIENT_COUNT = 7;

// CSPRNG Windows : remplit un buffer d'octets à partir du générateur cryptographique système.
// Utilisé pour générer le token Bearer REST avec une entropie forte (>= 256 bits), au lieu du
// PRNG Random() non cryptographique. hAlgorithm = 0 + BCRYPT_USE_SYSTEM_PREFERRED_RNG.
function BCryptGenRandom(hAlgorithm: Cardinal; var pbBuffer: Byte; cbBuffer: Cardinal; dwFlags: Cardinal): Integer;
  external 'BCryptGenRandom@bcrypt.dll stdcall';

function IsSmokeBuild(): Boolean;
begin
  Result := {#NexusSmokeMode} = 1;
end;

function InstallerRegistryPath(): String;
begin
  { Smoke builds use an isolated key so install/uninstall smoke cycles never mutate
    a real user's NEXUS registry state (managed markers, ManagedPath, etc.). }
  if IsSmokeBuild() then
    Result := 'Software\FTurleque\NEXUS-Smoke'
  else
    Result := 'Software\FTurleque\NEXUS';
end;

function InstallNative(): Boolean;
begin
  Result := (DeploymentPage.SelectedValueIndex = 0) or (DeploymentPage.SelectedValueIndex = 2);
end;

function InstallDocker(): Boolean;
begin
  Result := (not IsSmokeBuild()) and ((DeploymentPage.SelectedValueIndex = 1) or (DeploymentPage.SelectedValueIndex = 2));
end;

function IsCustomProfile(): Boolean;
begin
  Result := ProfilePage.SelectedValueIndex = 1;
end;

function InstallNativeCli(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[0];
end;

function InstallNativeMcp(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[1];
end;

function InstallNativeRest(): Boolean;
begin
  Result := InstallNative() and NativeOptionsPage.Values[2];
end;

function OllamaEnabled(): Boolean;
begin
  Result := SemanticPage.Values[0];
end;

function SemanticProviderValue(): String;
begin
  if OllamaEnabled() then
    Result := 'ollama'
  else
    Result := '';
end;

function AssistantIntegrationAvailable(): Boolean;
begin
  Result := InstallNativeMcp() or InstallDocker();
end;

{ A row counts only while it is enabled: a client absent from this machine or
  already connected to NEXUS is disabled and never configured again. }
function ClientSelected(Index: Integer): Boolean;
begin
  Result := AssistantIntegrationAvailable() and ClientBoxes[Index].Enabled and ClientBoxes[Index].Checked;
end;

function HasAssistantSelection(): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to CLIENT_COUNT - 1 do
    if ClientSelected(I) then Result := True;
end;

function UseDockerForIntegrations(): Boolean;
begin
  if InstallDocker() and not InstallNative() then
    Result := True
  else if InstallDocker() and InstallNative() then
    Result := IntegrationRuntimePage.SelectedValueIndex = 1
  else
    Result := False;
end;

function TrimTrailingBackslash(Value: String): String;
begin
  Result := Value;
  while (Length(Result) > 3) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function JsonEscape(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function TomlEscape(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function DockerPath(Value: String): String;
begin
  Result := TrimTrailingBackslash(Value);
  StringChangeEx(Result, '\', '/', True);
end;

function IsLoopbackOllamaHost(Host: String): Boolean;
begin
  // Miroir de com.nexus.search.semantic.ollama.OllamaEndpointResolver#isLoopbackHost.
  Host := Lowercase(Trim(Host));
  if (Length(Host) >= 2) and (Host[1] = '[') and (Host[Length(Host)] = ']') then
    Host := Copy(Host, 2, Length(Host) - 2);
  Result := (Host = 'localhost') or (Host = '::1') or (Copy(Host, 1, 4) = '127.');
end;

function OllamaUrlForDocker(Url: String): String;
var
  SchemePos, PathPos, PortColon, BracketEnd: Integer;
  Prefix, Authority, HostPart, Suffix, Rest: String;
begin
  // Résout une URL Ollama de bouclage vers host.docker.internal pour le runtime Docker Desktop.
  // Tout hôte non-bouclage (distant, DNS personnalisé, IPv6 non-::1) est renvoyé inchangé afin de
  // rester joignable à l'identique depuis les deux runtimes. Le runtime NEXUS applique la même
  // résolution défensivement via NEXUS_RUNTIME=docker ; cette fonction garantit surtout que le
  // fichier .env généré affiche l'endpoint réellement utilisé.
  Result := Url;
  Url := Trim(Url);
  SchemePos := Pos('://', Url);
  if SchemePos = 0 then exit;
  Prefix := Copy(Url, 1, SchemePos + 2);
  Rest := Copy(Url, SchemePos + 3, Length(Url));
  PathPos := Pos('/', Rest);
  if PathPos > 0 then
  begin
    Authority := Copy(Rest, 1, PathPos - 1);
    Suffix := Copy(Rest, PathPos, Length(Rest));
  end
  else
  begin
    Authority := Rest;
    Suffix := '';
  end;

  if (Length(Authority) > 0) and (Authority[1] = '[') then
  begin
    BracketEnd := Pos(']', Authority);
    if BracketEnd = 0 then exit;
    HostPart := Copy(Authority, 1, BracketEnd);
    if IsLoopbackOllamaHost(HostPart) then
      Result := Prefix + 'host.docker.internal' + Copy(Authority, BracketEnd + 1, Length(Authority)) + Suffix;
  end
  else
  begin
    PortColon := Pos(':', Authority);
    if PortColon > 0 then
      HostPart := Copy(Authority, 1, PortColon - 1)
    else
      HostPart := Authority;
    if IsLoopbackOllamaHost(HostPart) then
    begin
      if PortColon > 0 then
        Result := Prefix + 'host.docker.internal' + Copy(Authority, PortColon, Length(Authority)) + Suffix
      else
        Result := Prefix + 'host.docker.internal' + Suffix;
    end;
  end;
end;

function PathContainsEntry(PathValue: String; Entry: String): Boolean;
var
  Haystack: String;
  Needle: String;
begin
  Haystack := ';' + Lowercase(PathValue) + ';';
  Needle := ';' + Lowercase(TrimTrailingBackslash(Entry)) + ';';
  Result := Pos(Needle, Haystack) > 0;
end;

function CommandExists(Name: String): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/D /S /C "where ' + Name + ' >nul 2>nul"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function OllamaExecutable(): String;
var
  Candidate: String;
begin
  Result := '';
  Candidate := GetEnv('LOCALAPPDATA') + '\Programs\Ollama\ollama.exe';
  if FileExists(Candidate) then begin Result := Candidate; exit; end;
  if CommandExists('ollama') then begin Result := 'ollama'; exit; end;
end;

function OllamaPresent(): Boolean;
begin
  Result := OllamaExecutable() <> '';
end;

function OllamaAutoInstallSelected(): Boolean;
begin
  Result := OllamaEnabled() and OllamaPrereqPage.Values[0];
end;

function DockerDesktopExecutable(): String;
var
  Candidate: String;
begin
  Result := '';
  Candidate := GetEnv('LOCALAPPDATA') + '\Programs\DockerDesktop\Docker Desktop.exe';
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    exit;
  end;
  Candidate := ExpandConstant('{autopf}\Docker\Docker\Docker Desktop.exe');
  if FileExists(Candidate) then Result := Candidate;
end;

function DockerCliExecutable(): String;
var
  Candidate: String;
begin
  Result := '';
  if CommandExists('docker') then
  begin
    Result := 'docker';
    exit;
  end;
  Candidate := GetEnv('LOCALAPPDATA') + '\Programs\DockerDesktop\resources\bin\docker.exe';
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    exit;
  end;
  Candidate := ExpandConstant('{autopf}\Docker\Docker\resources\bin\docker.exe');
  if FileExists(Candidate) then Result := Candidate;
end;

function DockerEngineReady(): Boolean;
var
  DockerCli: String;
  ResultCode: Integer;
begin
  // Un docker.exe sur le PATH n'est qu'un client : il ne doit pas supprimer l'installation de
  // Docker Desktop s'il ne peut pas réellement joindre un engine. Un Docker Desktop installé mais
  // arrêté reste accepté (le lanceur post-install le démarre).
  Result := False;
  DockerCli := DockerCliExecutable();
  if DockerCli = '' then exit;

  if DockerCli = 'docker' then
    Result := Exec(ExpandConstant('{cmd}'), '/D /S /C "docker info >nul 2>nul"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0)
  else
    Result := Exec(DockerCli, 'info', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function DockerRuntimePresent(): Boolean;
begin
  Result := DockerEngineReady() or (DockerDesktopExecutable() <> '');
end;

function DockerDesktopAutoInstallSelected(): Boolean;
begin
  Result := InstallDocker() and DockerPrereqPage.Values[0];
end;

{ PowerShell ends a single-quoted string on U+0027 and on the typographic quotes
  U+2018, U+2019, U+201A and U+201B: each is doubled to stay literal. }
function PowerShellSingleQuote(Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '''', '''''', True);
  StringChangeEx(Result, #$2018, #$2018#$2018, True);
  StringChangeEx(Result, #$2019, #$2019#$2019, True);
  StringChangeEx(Result, #$201A, #$201A#$201A, True);
  StringChangeEx(Result, #$201B, #$201B#$201B, True);
end;

function VerifyDockerDesktopInstaller(InstallerPath: String): Boolean;
var
  PowerShellPath: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := False;
  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellPath) then exit;
  Script :=
    '$s=Get-AuthenticodeSignature -LiteralPath ''' + PowerShellSingleQuote(InstallerPath) + '''; ' +
    'if (($s.Status -eq ''Valid'') -and ($null -ne $s.SignerCertificate) -and ' +
    '($s.SignerCertificate.Subject -match ''(^|,\s*)CN=Docker Inc(,|$)'')) { exit 0 } else { exit 1 }';
  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';
  Result := Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function VerifyOllamaInstaller(InstallerPath: String): Boolean;
var
  PowerShellPath: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  // Vérification Authenticode fail-closed du programme d'installation Ollama, alignée sur celle de
  // Docker Desktop. Le signataire attendu (CN=Ollama Inc.) provient du certificat DigiCert réel du
  // binaire officiellement distribué par Ollama — jamais une valeur arbitraire. Toute signature
  // absente, invalide, ou d'un autre signataire entraîne un refus d'exécution.
  Result := False;
  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellPath) then exit;
  Script :=
    '$s=Get-AuthenticodeSignature -LiteralPath ''' + PowerShellSingleQuote(InstallerPath) + '''; ' +
    'if (($s.Status -eq ''Valid'') -and ($null -ne $s.SignerCertificate) -and ' +
    '($s.SignerCertificate.Subject -match ''(^|,\s*)CN=Ollama Inc\.(,|$)'')) { exit 0 } else { exit 1 }';
  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';
  Result := Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function InstallDockerDesktopIfNeeded(): String;
var
  InstallerPath: String;
  ResultCode: Integer;
  DownloadedSize: Int64;
begin
  Result := '';
  if not InstallDocker() or DockerRuntimePresent() then exit;
  if not DockerDesktopAutoInstallSelected() then
  begin
    Result := 'Docker Desktop/CLI est absent et son installation automatique est désactivée.';
    exit;
  end;

  try
    DownloadedSize := DownloadTemporaryFile(
      'https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe',
      'NEXUS-Docker-Desktop-Installer.exe', '', nil);
    Log('Docker Desktop téléchargé : ' + IntToStr(DownloadedSize) + ' octets.');
  except
    Result := 'Impossible de télécharger Docker Desktop depuis le domaine officiel Docker : ' + GetExceptionMessage;
    exit;
  end;

  InstallerPath := ExpandConstant('{tmp}\NEXUS-Docker-Desktop-Installer.exe');
  if not FileExists(InstallerPath) then
  begin
    Result := 'Le téléchargement Docker Desktop n''a pas produit le fichier attendu.';
    exit;
  end;
  if not VerifyDockerDesktopInstaller(InstallerPath) then
  begin
    Result := 'La signature Authenticode de Docker Desktop est invalide ou le signataire n''est pas Docker Inc. Installation annulée.';
    exit;
  end;

  if not Exec(InstallerPath, 'install --user --backend=wsl-2 --quiet', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
  begin
    Result := 'L''installation Docker Desktop a échoué avec le code ' + IntToStr(ResultCode) + '.';
    exit;
  end;

  if not DockerRuntimePresent() then
  begin
    Result := 'Docker Desktop a terminé son installation mais aucun runtime Docker n''a été détecté.';
    exit;
  end;

  DockerDesktopInstalledDuringSetup := True;
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerDesktopInstalledByNexus', '1');
end;

function IsSafeBindAddress(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Value := Trim(Value);
  Result := Value <> '';
  if not Result then exit;

  for I := 1 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'a') and (C <= 'z')) or
            ((C >= 'A') and (C <= 'Z')) or
            ((C >= '0') and (C <= '9')) or
            (C = '.') or (C = ':') or (C = '-')) then
    begin
      Result := False;
      exit;
    end;
  end;
end;

function IsTcpPortAvailable(BindAddress: String; Port: Integer): Boolean;
var
  PowerShellPath: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := False;
  BindAddress := Trim(BindAddress);
  if (Port < 1) or (Port > 65535) or not IsSafeBindAddress(BindAddress) then exit;

  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if not FileExists(PowerShellPath) then
  begin
    Log('PowerShell Windows introuvable pour le test de disponibilité du port.');
    exit;
  end;

  Script :=
    '$ErrorActionPreference=''Stop''; $listener=$null; try { ' +
    '$address=''' + BindAddress + '''; ' +
    'if ($address -eq ''localhost'') { $address=''127.0.0.1'' }; ' +
    '$ip=$null; if (-not [System.Net.IPAddress]::TryParse($address,[ref]$ip)) { ' +
    '$ip=[System.Net.Dns]::GetHostAddresses($address) | Select-Object -First 1 }; ' +
    'if ($null -eq $ip) { exit 2 }; ' +
    '$listener=[System.Net.Sockets.TcpListener]::new($ip,' + IntToStr(Port) + '); ' +
    '$listener.Start(); $listener.Stop(); exit 0 } catch { ' +
    'if ($null -ne $listener) { try { $listener.Stop() } catch {} }; exit 1 }';
  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "' + Script + '"';

  Result := Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function FindAvailableTcpPort(BindAddress: String; RequestedPort: Integer; ReservedPort: Integer): Integer;
var
  Candidate: Integer;
begin
  Result := -1;
  if (RequestedPort < 1) or (RequestedPort > 65535) then exit;

  Candidate := RequestedPort;
  while Candidate <= 65535 do
  begin
    if ((ReservedPort < 1) or (Candidate <> ReservedPort)) and IsTcpPortAvailable(BindAddress, Candidate) then
    begin
      Result := Candidate;
      exit;
    end;
    Candidate := Candidate + 1;
  end;

  Candidate := 1024;
  while Candidate < RequestedPort do
  begin
    if ((ReservedPort < 1) or (Candidate <> ReservedPort)) and IsTcpPortAvailable(BindAddress, Candidate) then
    begin
      Result := Candidate;
      exit;
    end;
    Candidate := Candidate + 1;
  end;
end;

{ True when the NEXUS container a previous run of this installer manages already
  publishes BindAddress:Port on the host. Reinstalling recreates that container,
  which releases the port and takes it back, so the port is not taken by someone else. }
function ManagedContainerPublishesPort(Container: String; BindAddress: String; Port: Integer): Boolean;
var
  Value: String;
  Docker: String;
  OutFile: String;
  Output: AnsiString;
  Text: String;
  ResultCode: Integer;
begin
  Result := False;
  if not (RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', Value) and (Value = '1')) then exit;
  if not (RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', Value) and
          (CompareText(Trim(Value), Trim(Container)) = 0)) then exit;
  Docker := DockerCliExecutable();
  if Docker = '' then exit;
  OutFile := ExpandConstant('{tmp}\nexus-docker-port.txt');
  DeleteFile(OutFile);
  if (not Exec(ExpandConstant('{cmd}'),
      '/D /S /C ""' + Docker + '" port "' + Trim(Container) + '" > "' + OutFile + '" 2>nul"',
      '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then exit;
  if not LoadStringFromFile(OutFile, Output) then exit;
  { `docker port` prints one "8080/tcp -> 127.0.0.1:8082" line per published port. }
  Text := String(Output) + #10;
  StringChangeEx(Text, #13, '', True);
  Result := Pos(' ' + Trim(BindAddress) + ':' + IntToStr(Port) + #10, Text) > 0;
  if Result then
    Log('Docker REST port ' + IntToStr(Port) + ' is published by the managed NEXUS container ' + Trim(Container) + '; kept.');
end;

procedure NotifyPortSelection(Description: String; RequestedPort: Integer; SelectedPort: Integer);
begin
  if RequestedPort <> SelectedPort then
    MsgBox(
      Description + ' ' + IntToStr(RequestedPort) + ' est déjà utilisé.' + #13#10 +
      'NEXUS a sélectionné automatiquement le premier port TCP disponible : ' + IntToStr(SelectedPort) + '.',
      mbInformation, MB_OK);
end;

function GenerateLocalToken(): String;
var
  Buffer: array of Byte;
  Status: Integer;
  I: Integer;
  Hex: String;
begin
  // 32 octets = 256 bits d'entropie issus du CSPRNG système. Encodage hexadécimal : alphabet
  // [0-9a-f] strictement sûr pour .env, cmd, Docker Compose et l'en-tête HTTP Authorization —
  // aucun caractère nécessitant un échappement, aucun CR/LF. Aucun fallback non cryptographique.
  SetLength(Buffer, 32);
  Status := BCryptGenRandom(0, Buffer[0], 32, BCRYPT_USE_SYSTEM_PREFERRED_RNG);
  if Status <> 0 then
    RaiseException('Génération cryptographique du token REST échouée (BCryptGenRandom, status '
      + IntToStr(Status) + ').');
  Hex := '0123456789abcdef';
  Result := '';
  for I := 0 to 31 do
    Result := Result + Hex[((Buffer[I] shr 4) and 15) + 1] + Hex[(Buffer[I] and 15) + 1];
end;

procedure AddNexusToUserPath;
var
  CurrentPath: String;
  AppPath: String;
begin
  if IsSmokeBuild() or not InstallNative() or not WizardIsTaskSelected('addtopath') then exit;
  AppPath := TrimTrailingBackslash(ExpandConstant('{app}'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then CurrentPath := '';
  if not PathContainsEntry(CurrentPath, AppPath) then
  begin
    if (CurrentPath <> '') and (CurrentPath[Length(CurrentPath)] <> ';') then CurrentPath := CurrentPath + ';';
    CurrentPath := CurrentPath + AppPath;
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', CurrentPath);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', AppPath);
  end;
end;

procedure RemoveNexusFromUserPath;
var
  CurrentPath: String;
  ManagedPath: String;
  PaddedPath: String;
  Needle: String;
begin
  if IsSmokeBuild() then exit;
  if not RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', ManagedPath) then exit;
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
  begin
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
    exit;
  end;
  PaddedPath := ';' + CurrentPath + ';';
  Needle := ';' + TrimTrailingBackslash(ManagedPath) + ';';
  StringChangeEx(PaddedPath, Needle, ';', True);
  while (Length(PaddedPath) > 0) and (PaddedPath[1] = ';') do Delete(PaddedPath, 1, 1);
  while (Length(PaddedPath) > 0) and (PaddedPath[Length(PaddedPath)] = ';') do Delete(PaddedPath, Length(PaddedPath), 1);
  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', PaddedPath);
  RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
end;

function IsOfficialNexusImage(Value: String): Boolean;
var
  Image: String;
begin
  Image := Lowercase(Trim(Value));
  Result := (Pos('ghcr.io/fturleque/nexus-context-engine:', Image) = 1) or
            (Pos('ghcr.io/fturleque/nexus-context-engine@', Image) = 1);
end;

procedure LoadPreviousSettings;
var
  Value: String;
  Mode: Cardinal;
begin
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', Mode) and (Mode <= 2) then
    DeploymentPage.SelectedValueIndex := Mode;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', Value) then RuntimePage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', Value) then RuntimePage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', Value) then RuntimePage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', Value) then RuntimePage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', Value) then SemanticPage.Values[0] := Lowercase(Trim(Value)) = 'ollama';
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', Value) then OllamaPage.Values[0] := Value;
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'OllamaAutoInstall', Mode) then OllamaPrereqPage.Values[0] := Mode <> 0;
  if RegQueryDWordValue(HKCU, InstallerRegistryPath(), 'DockerAutoInstall', Mode) then DockerPrereqPage.Values[0] := Mode <> 0;
  { The official NEXUS image follows the version being installed: a saved official
    reference keeps the default set in InitializeWizard. Only a custom image is restored. }
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', Value) and
     (not IsOfficialNexusImage(Value)) then DockerPage.Values[0] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', Value) then DockerPage.Values[1] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', Value) then DockerPage.Values[2] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', Value) then DockerPage.Values[3] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', Value) then DockerPage.Values[4] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', Value) then DockerPage.Values[5] := Value;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', Value) then DockerPage.Values[6] := Value;
end;

