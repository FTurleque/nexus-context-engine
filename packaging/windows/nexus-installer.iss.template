{ Generated PowerShell scripts are written in UTF-8 with a BOM. Windows PowerShell 5.1
  reads a BOM-less script in the ANSI code page, and SaveStringToFile converts Unicode to
  that code page with best-fit mapping: U+FF07 or U+02BC would become an ASCII apostrophe
  that PowerShellSingleQuote never saw. With the BOM, every character reaches PowerShell
  unchanged and the quoting of PowerShellSingleQuote holds. }
procedure SavePowerShellScript(Path: String; Text: String);
var
  Lines: TArrayOfString;
begin
  SetArrayLength(Lines, 1);
  Lines[0] := Text;
  if not SaveStringsToUTF8File(Path, Lines, False) then
    Log('Unable to write ' + Path);
end;

{ Emit the shared PowerShell helper (integrations\nexus-json.ps1), the only reader and
  writer of the assistant clients' JSON configurations:
  - Read-ClientJson reads UTF-8 (Windows PowerShell 5.1's Get-Content would use the
    ANSI code page) and throws unless the file holds a JSON object;
  - Save-CleanJson re-indents with 2 spaces (5.1's ConvertTo-Json emits a deep-aligned
    layout), writes a temporary file of the same folder, then File.Replace keeps the
    original as <file>.nexus-backup-<yyyyMMddHHmmss>, never overwriting a backup;
  - Add-NexusServerEntry reads and checks every file first, then writes: one file
    that is not a JSON object, or whose server section is not an object, leaves every
    file unchanged;
  - Remove-NexusServerEntry goes on past an unreadable file and throws at the end.
  Callers set $ErrorActionPreference = 'Stop' and a trap that prints the message,
  which names the file without its content, then exits 1. }
procedure WriteJsonHelper(Dir: String);
var
  S: String;
begin
  S :=
    'function Format-Json([string]$Compressed) {' + #13#10 +
    '  $sb = New-Object System.Text.StringBuilder' + #13#10 +
    '  $indent = 0; $inStr = $false; $esc = $false' + #13#10 +
    '  for ($i = 0; $i -lt $Compressed.Length; $i++) {' + #13#10 +
    '    $ch = $Compressed[$i]' + #13#10 +
    '    if ($inStr) {' + #13#10 +
    '      [void]$sb.Append($ch)' + #13#10 +
    '      if ($esc) { $esc = $false } elseif ($ch -eq [char]92) { $esc = $true } elseif ($ch -eq [char]34) { $inStr = $false }' + #13#10 +
    '      continue' + #13#10 +
    '    }' + #13#10 +
    '    if ($ch -eq [char]34) { $inStr = $true; [void]$sb.Append($ch); continue }' + #13#10 +
    '    if ($ch -eq [char]123 -or $ch -eq [char]91) {' + #13#10 +
    '      if ((($i + 1) -lt $Compressed.Length) -and ($Compressed[$i + 1] -eq [char]125 -or $Compressed[$i + 1] -eq [char]93)) {' + #13#10 +
    '        [void]$sb.Append($ch); [void]$sb.Append($Compressed[$i + 1]); $i++' + #13#10 +
    '      } else {' + #13#10 +
    '        $indent++; [void]$sb.Append($ch); [void]$sb.Append("`r`n" + ("  " * $indent))' + #13#10 +
    '      }' + #13#10 +
    '      continue' + #13#10 +
    '    }' + #13#10 +
    '    if ($ch -eq [char]125 -or $ch -eq [char]93) { $indent--; [void]$sb.Append("`r`n" + ("  " * $indent)); [void]$sb.Append($ch); continue }' + #13#10 +
    '    if ($ch -eq [char]44) { [void]$sb.Append($ch); [void]$sb.Append("`r`n" + ("  " * $indent)); continue }' + #13#10 +
    '    if ($ch -eq [char]58) { [void]$sb.Append($ch); [void]$sb.Append([char]32); continue }' + #13#10 +
    '    [void]$sb.Append($ch)' + #13#10 +
    '  }' + #13#10 +
    '  return $sb.ToString()' + #13#10 +
    '}' + #13#10 +
    'function Read-ClientJson([string]$Path) {' + #13#10 +
    '  $text = [System.IO.File]::ReadAllText($Path, [System.Text.UTF8Encoding]::new($false))' + #13#10 +
    '  try { $data = $text | ConvertFrom-Json } catch { throw (''Invalid JSON: '' + $Path) }' + #13#10 +
    '  if (-not ($data -is [System.Management.Automation.PSCustomObject])) { throw (''Not a JSON object: '' + $Path) }' + #13#10 +
    '  return $data' + #13#10 +
    '}' + #13#10 +
    'function Get-ClientSection([object]$Data, [string]$Section, [string]$Path) {' + #13#10 +
    '  $member = $Data.PSObject.Properties[$Section]' + #13#10 +
    '  if ($null -eq $member) { return $null }' + #13#10 +
    '  if (-not ($member.Value -is [System.Management.Automation.PSCustomObject])) { throw (''Not a JSON object: '' + $Section + '' in '' + $Path) }' + #13#10 +
    '  return $member.Value' + #13#10 +
    '}' + #13#10 +
    'function Save-CleanJson([string]$Path, [object]$Data) {' + #13#10 +
    '  $compressed = $Data | ConvertTo-Json -Depth 30 -Compress' + #13#10 +
    '  $pretty = Format-Json $compressed' + #13#10 +
    '  $dir = Split-Path $Path -Parent' + #13#10 +
    '  if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }' + #13#10 +
    '  $tmp = $Path + ''.nexus-'' + [guid]::NewGuid().ToString(''N'') + ''.tmp''' + #13#10 +
    '  $candidate = $null' + #13#10 +
    '  try {' + #13#10 +
    '    [System.IO.File]::WriteAllText($tmp, $pretty + "`r`n", [System.Text.UTF8Encoding]::new($false))' + #13#10 +
    '    if (Test-Path -LiteralPath $Path) {' + #13#10 +
    '      $backup = $Path + ''.nexus-backup-'' + (Get-Date -Format ''yyyyMMddHHmmss'')' + #13#10 +
    '      $candidate = $backup; $n = 1' + #13#10 +
    '      while (Test-Path -LiteralPath $candidate) { $candidate = $backup + ''-'' + $n; $n++ }' + #13#10 +
    '      [System.IO.File]::Replace($tmp, $Path, $candidate)' + #13#10 +
    '    } else {' + #13#10 +
    '      [System.IO.File]::Move($tmp, $Path)' + #13#10 +
    '    }' + #13#10 +
    '  } catch {' + #13#10 +
    '    if ($candidate -and -not (Test-Path -LiteralPath $Path) -and (Test-Path -LiteralPath $candidate)) { [System.IO.File]::Move($candidate, $Path) }' + #13#10 +
    '    throw' + #13#10 +
    '  } finally {' + #13#10 +
    '    if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Force }' + #13#10 +
    '  }' + #13#10 +
    '}' + #13#10 +
    'function Add-NexusServerEntry([string[]]$Paths, [string]$Section, [object]$Entry) {' + #13#10 +
    '  $pending = @()' + #13#10 +
    '  foreach ($cfg in $Paths) {' + #13#10 +
    '    $c = $null' + #13#10 +
    '    if (Test-Path -LiteralPath $cfg) { $c = Read-ClientJson $cfg } else { $c = [PSCustomObject]@{} }' + #13#10 +
    '    $servers = Get-ClientSection $c $Section $cfg' + #13#10 +
    '    if ($null -eq $servers) { $servers = [PSCustomObject]@{}; $c | Add-Member -MemberType NoteProperty -Name $Section -Value $servers }' + #13#10 +
    '    if ($null -ne $servers.PSObject.Properties[''nexus'']) { continue }' + #13#10 +
    '    $servers | Add-Member -MemberType NoteProperty -Name nexus -Value $Entry' + #13#10 +
    '    $pending += ,@($cfg, $c)' + #13#10 +
    '  }' + #13#10 +
    '  foreach ($item in $pending) { Save-CleanJson $item[0] $item[1] }' + #13#10 +
    '  return $pending.Count' + #13#10 +
    '}' + #13#10 +
    'function Remove-NexusServerEntry([string[]]$Paths, [string]$Section) {' + #13#10 +
    '  $failed = @()' + #13#10 +
    '  foreach ($cfg in $Paths) {' + #13#10 +
    '    try {' + #13#10 +
    '      if (-not (Test-Path -LiteralPath $cfg)) { continue }' + #13#10 +
    '      $c = Read-ClientJson $cfg' + #13#10 +
    '      $servers = Get-ClientSection $c $Section $cfg' + #13#10 +
    '      if ($null -eq $servers -or $null -eq $servers.PSObject.Properties[''nexus'']) { continue }' + #13#10 +
    '      $servers.PSObject.Properties.Remove(''nexus'')' + #13#10 +
    '      Save-CleanJson $cfg $c' + #13#10 +
    '    } catch { $failed += $_.Exception.Message }' + #13#10 +
    '  }' + #13#10 +
    '  if ($failed.Count -gt 0) { throw ($failed -join ''; '') }' + #13#10 +
    '}' + #13#10;
  SavePowerShellScript(Dir + '\nexus-json.ps1', S);
end;

{ Return a PowerShell literal for the nexus MCP entry, honouring the runtime choice
  (docker exec vs native cmd.exe launcher). IncludeType adds the "type":"stdio"
  field required by GitHub Copilot's JetBrains config. }
function McpEntryPsLiteral(IncludeType: Boolean): String;
var
  TypePart: String;
begin
  if IncludeType then TypePart := 'type = ''stdio''; ' else TypePart := '';
  if UseDockerForIntegrations() then
    Result := '[PSCustomObject]@{ ' + TypePart + 'command = ''docker''; args = @(''exec'', ''-i'', ''' +
      PowerShellSingleQuote(DockerPage.Values[1]) + ''', ''java'', ''-jar'', ''/opt/nexus/lib/nexus-mcp.jar'') }'
  else
    Result := '[PSCustomObject]@{ ' + TypePart + 'command = ''cmd.exe''; args = @(''/d'', ''/s'', ''/c'', ''' +
      PowerShellSingleQuote(ExpandConstant('{app}\nexus-mcp.cmd')) + ''') }';
end;

{ Return a PowerShell array literal for the MCP command+args (for CLI `mcp add -- ...`). }
function McpCommandArrayPs(): String;
begin
  if UseDockerForIntegrations() then
    Result := '@(''docker'', ''exec'', ''-i'', ''' + PowerShellSingleQuote(DockerPage.Values[1]) +
      ''', ''java'', ''-jar'', ''/opt/nexus/lib/nexus-mcp.jar'')'
  else
    Result := '@(''cmd.exe'', ''/d'', ''/s'', ''/c'', ''' +
      PowerShellSingleQuote(ExpandConstant('{app}\nexus-mcp.cmd')) + ''')';
end;

{ PowerShell prologue that sets $exe to the Claude Code CLI: on PATH first, then
  the copy Claude Desktop embeds under %APPDATA%\Claude\claude-code\<version>.
  Exits 10 when neither exists. }
function ClaudeCliResolverPs(): String;
begin
  Result :=
    '$exe = $null' + #13#10 +
    '$c = Get-Command claude -EA SilentlyContinue | Select-Object -First 1' + #13#10 +
    'if ($c -and ($c.CommandType -in @(''Application'', ''ExternalScript''))) { $exe = $c.Source }' + #13#10 +
    'if (-not $exe) {' + #13#10 +
    '  $d = Join-Path $env:APPDATA ''Claude\claude-code''' + #13#10 +
    '  if (Test-Path $d) { $exe = Get-ChildItem $d -Directory -EA SilentlyContinue | Sort-Object LastWriteTime -Descending | ForEach-Object { Join-Path $_.FullName ''claude.exe'' } | Where-Object { Test-Path $_ } | Select-Object -First 1 }' + #13#10 +
    '}' + #13#10 +
    'if (-not $exe) { exit 10 }' + #13#10;
end;

{ PowerShell prologue that sets $cfgs to every Claude Desktop configuration file:
  one per Microsoft Store package folder, plus %APPDATA%\Claude for the standard
  installer. A machine can keep both, only one of them being the running app's;
  every present folder is listed so that the running app's file is always among them. }
function ClaudeDesktopConfigsPs(): String;
begin
  Result :=
    '$cfgs = @()' + #13#10 +
    '$pkgs = Join-Path $env:LOCALAPPDATA ''Packages''' + #13#10 +
    'if (Test-Path $pkgs) { foreach ($p in (Get-ChildItem $pkgs -Directory -Filter ''Claude_*'' -EA SilentlyContinue)) { $d = Join-Path $p.FullName ''LocalCache\Roaming\Claude''; if (Test-Path $d) { $cfgs += (Join-Path $d ''claude_desktop_config.json'') } } }' + #13#10 +
    '$fb = Join-Path $env:APPDATA ''Claude''' + #13#10 +
    'if (Test-Path $fb) { $cfgs += (Join-Path $fb ''claude_desktop_config.json'') }' + #13#10;
end;

{ PowerShell guard that exits 30 while Claude Desktop runs: the app keeps its
  configuration in memory and rewrites claude_desktop_config.json from that copy,
  which drops any entry written meanwhile. Claude Code CLI processes live
  elsewhere and are not matched. }
function ClaudeDesktopClosedGuardPs(): String;
begin
  Result :=
    '$app = Join-Path $env:LOCALAPPDATA ''AnthropicClaude''' + #13#10 +
    'if (Get-Process claude -EA SilentlyContinue | Where-Object { $_.Path -and ($_.Path.StartsWith($app, [StringComparison]::OrdinalIgnoreCase) -or ($_.Path -like ''*\WindowsApps\Claude_*'')) }) { Write-Host ''Claude Desktop is running: quit it, then run this script again.''; exit 30 }' + #13#10;
end;

{ Runs a Claude Desktop script until Claude Desktop is closed or the user gives up:
  exit 30 shows a Retry/Cancel prompt (never in silent mode). }
function RunWhileClaudeDesktopClosed(ScriptPath: String; RegistryName: String; Removing: Boolean): Integer;
var
  ResultCode: Integer;
  Action: String;
begin
  if Removing then Action := 'retirer NEXUS de' else Action := 'ajouter NEXUS à';
  repeat
    Result := -1;
    if not FileExists(ScriptPath) then exit;
    if Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
        '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ScriptPath + '"',
        '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
      Result := ResultCode;
    if Result <> 30 then break;
    Log(ScriptPath + ': Claude Desktop is running');
    if IsUninstaller() then
    begin
      if UninstSilent then break;
    end
    else if WizardSilent() then break;
  until MsgBox('Claude Desktop est ouvert. Pour ' + Action + ' sa configuration, quittez-le complètement :' + #13#10 +
      'clic droit sur l''icône Claude près de l''horloge, puis Quitter.' + #13#10 + #13#10 +
      'Cliquez ensuite sur Réessayer. Annuler laisse Claude Desktop inchangé.',
      mbConfirmation, MB_RETRYCANCEL) <> IDRETRY;
  if (Result = 0) and (RegistryName <> '') then
    RegWriteStringValue(HKCU, InstallerRegistryPath(), RegistryName, '1');
end;

function PowerShellLauncherCmd(ScriptName: String): String;
begin
  Result :=
    '@echo off' + #13#10 +
    '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0' + ScriptName + '"' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
end;

procedure WriteAssistantAssets;
var
  Dir: String;
  CopilotScript: String;
  CopilotCmd: String;
  ClaudeDesktopPsScript: String;
  ClaudeDesktopCmd: String;
  CodexScript: String;
  CodexCmd: String;
  JetBrainsPsScript: String;
  JetBrainsCmd: String;
begin
  if not HasAssistantSelection() then exit;
  Dir := ExpandConstant('{app}\integrations');
  ForceDirectories(Dir);
  WriteJsonHelper(Dir);

  if ClientSelected(CLIENT_COPILOT_JETBRAINS) then
  begin
    { Static JSON fallback — restored Docker handling, kept for manual import. }
    if UseDockerForIntegrations() then
      SaveUtf8TextFile(Dir + '\copilot-jetbrains.mcp.json', DockerMcpCommandJson('servers'))
    else
      SaveUtf8TextFile(Dir + '\copilot-jetbrains.mcp.json', NativeMcpCommandJson('servers'));

    { PS1: merge nexus entry into the live IntelliJ Copilot mcp.json using the
      same cmd.exe + nexus-mcp.cmd pattern as mcp-search-net.
      - exit 10 : mcp.json absent OR nexus-mcp.cmd not installed
      - exit 20 : nexus key already present (idempotent)
      - exit 0  : nexus added successfully
      - exit 1  : mcp.json unreadable as a JSON object, left unchanged }
    JetBrainsPsScript :=
      '$ErrorActionPreference = ''Stop''' + #13#10 +
      'trap { Write-Host (''NEXUS: '' + $_.Exception.Message); exit 1 }' + #13#10 +
      '. (Join-Path $PSScriptRoot ''nexus-json.ps1'')' + #13#10 +
      '$dir = Join-Path $env:LOCALAPPDATA ''github-copilot\intellij''' + #13#10 +
      'if (-not (Test-Path $dir)) { exit 10 }' + #13#10 +
      '$mcp = Join-Path $dir ''mcp.json''' + #13#10 +
      '$e = ' + McpEntryPsLiteral(True) + #13#10 +
      '$added = Add-NexusServerEntry @($mcp) ''servers'' $e' + #13#10 +
      'if ($added -eq 0) { exit 20 }' + #13#10 +
      'exit 0' + #13#10;
    SavePowerShellScript(Dir + '\connect-copilot-jetbrains.ps1', JetBrainsPsScript);

    JetBrainsCmd :=
      '@echo off' + #13#10 +
      '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass' +
          ' -File "%~dp0connect-copilot-jetbrains.ps1"' + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-copilot-jetbrains.cmd', JetBrainsCmd, False);
  end;

  if ClientSelected(CLIENT_CODEX_DESKTOP) then
  begin
    if UseDockerForIntegrations() then
      SaveUtf8TextFile(Dir + '\codex-desktop.mcp.toml', DockerCodexToml())
    else
      SaveUtf8TextFile(Dir + '\codex-desktop.mcp.toml', NativeCodexToml());
  end;

  if ClientSelected(CLIENT_GENERIC) then
  begin
    if UseDockerForIntegrations() then
      SaveUtf8TextFile(Dir + '\generic-mcp.json', DockerMcpCommandJson('mcpServers'))
    else
      SaveUtf8TextFile(Dir + '\generic-mcp.json', NativeMcpCommandJson('mcpServers'));
  end;

  if ClientSelected(CLIENT_COPILOT_CLI) then
  begin
    { PS1: resolve copilot via Get-Command (handles the VS Code copilot.ps1 shim that
      `where copilot` cannot find), then `copilot mcp add nexus -- <cmd> <args...>`.
      Args are passed as an array so PowerShell does not swallow the `--` separator.
      - exit 10 : copilot CLI not resolvable
      - exit 20 : nexus already present
      - exit 0  : nexus added }
    CopilotScript :=
      '$c = Get-Command copilot -EA SilentlyContinue' + #13#10 +
      'if (-not $c -or ($c.CommandType -notin @(''Application'', ''ExternalScript''))) { exit 10 }' + #13#10 +
      '$exe = $c.Source' + #13#10 +
      '$list = (& $exe mcp list 2>&1 | Out-String)' + #13#10 +
      'if ($list -match ''(?m)^\s*nexus\b'') { exit 20 }' + #13#10 +
      '$cmd = ' + McpCommandArrayPs() + #13#10 +
      '$addArgs = @(''mcp'', ''add'', ''nexus'', ''--tools'', ''*'', ''--'') + $cmd' + #13#10 +
      '& $exe @addArgs' + #13#10 +
      'exit $LASTEXITCODE' + #13#10;
    SavePowerShellScript(Dir + '\connect-copilot-cli.ps1', CopilotScript);
    CopilotCmd :=
      '@echo off' + #13#10 +
      '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0connect-copilot-cli.ps1"' + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-copilot-cli.cmd', CopilotCmd, False);
  end;

  if ClientSelected(CLIENT_CLAUDE_DESKTOP) then
  begin
    { PS1: merge nexus into the mcpServers of every Claude Desktop configuration
      present (cmd.exe + nexus-mcp.cmd, same pattern as mcp-search-net).
      - exit 10 : no Claude Desktop configuration folder
      - exit 20 : nexus already present in each of them (idempotent)
      - exit 30 : Claude Desktop is running (its rewrite would drop the entry)
      - exit 0  : nexus added to at least one of them
      - exit 1  : a configuration is unreadable as a JSON object; every
                  configuration is left unchanged }
    ClaudeDesktopPsScript :=
      '$ErrorActionPreference = ''Stop''' + #13#10 +
      'trap { Write-Host (''NEXUS: '' + $_.Exception.Message); exit 1 }' + #13#10 +
      '. (Join-Path $PSScriptRoot ''nexus-json.ps1'')' + #13#10 +
      ClaudeDesktopConfigsPs() +
      'if ($cfgs.Count -gt 0) {' + #13#10 +
      ClaudeDesktopClosedGuardPs() +
      '}' + #13#10 +
      'if ($cfgs.Count -eq 0) { exit 10 }' + #13#10 +
      '$e = ' + McpEntryPsLiteral(False) + #13#10 +
      '$added = Add-NexusServerEntry $cfgs ''mcpServers'' $e' + #13#10 +
      'if ($added -eq 0) { exit 20 }' + #13#10 +
      'exit 0' + #13#10;
    SavePowerShellScript(Dir + '\connect-claude-desktop.ps1', ClaudeDesktopPsScript);

    ClaudeDesktopCmd :=
      '@echo off' + #13#10 +
      '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass' +
          ' -File "%~dp0connect-claude-desktop.ps1"' + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-claude-desktop.cmd', ClaudeDesktopCmd, False);
  end;

  if ClientSelected(CLIENT_CLAUDE_CODE) then
  begin
    { Claude Code: `claude mcp add --scope user nexus -- <cmd>`, with the CLI
      resolved on PATH or embedded by Claude Desktop.
      - exit 10 : Claude Code CLI not resolvable
      - exit 20 : nexus already present
      - exit 0  : nexus added }
    SavePowerShellScript(Dir + '\connect-claude-cli.ps1',
      ClaudeCliResolverPs() +
      '& $exe mcp get nexus *> $null' + #13#10 +
      'if ($LASTEXITCODE -eq 0) { exit 20 }' + #13#10 +
      '$cmd = ' + McpCommandArrayPs() + #13#10 +
      '$addArgs = @(''mcp'', ''add'', ''--scope'', ''user'', ''nexus'', ''--'') + $cmd' + #13#10 +
      '& $exe @addArgs' + #13#10 +
      'exit $LASTEXITCODE' + #13#10);
    SaveStringToFile(Dir + '\connect-claude-cli.cmd', PowerShellLauncherCmd('connect-claude-cli.ps1'), False);
  end;

  if ClientSelected(CLIENT_CODEX_CLI) then
  begin
    { Codex CLI: `codex mcp add nexus -- <cmd>` writes [mcp_servers.nexus] in
      ~/.codex/config.toml, which Codex Desktop reads too.
      - exit 10 : codex CLI not resolvable
      - exit 20 : nexus already present
      - exit 0  : nexus added }
    SavePowerShellScript(Dir + '\connect-codex-cli.ps1',
      '$c = Get-Command codex -EA SilentlyContinue | Select-Object -First 1' + #13#10 +
      'if (-not $c -or ($c.CommandType -notin @(''Application'', ''ExternalScript''))) { exit 10 }' + #13#10 +
      '$exe = $c.Source' + #13#10 +
      '& $exe mcp get nexus *> $null' + #13#10 +
      'if ($LASTEXITCODE -eq 0) { exit 20 }' + #13#10 +
      '$cmd = ' + McpCommandArrayPs() + #13#10 +
      '$addArgs = @(''mcp'', ''add'', ''nexus'', ''--'') + $cmd' + #13#10 +
      '& $exe @addArgs' + #13#10 +
      'exit $LASTEXITCODE' + #13#10);
    SaveStringToFile(Dir + '\connect-codex-cli.cmd', PowerShellLauncherCmd('connect-codex-cli.ps1'), False);
  end;

  if ClientSelected(CLIENT_CODEX_DESKTOP) then
  begin
    CodexScript :=
      '$scriptDir = Split-Path $MyInvocation.MyCommand.Path -Parent' + #13#10 +
      '$tomlSrc = Join-Path $scriptDir ''codex-desktop.mcp.toml''' + #13#10 +
      '$cfg = Join-Path $env:USERPROFILE ''.codex\config.toml''' + #13#10 +
      '$begin = ''# BEGIN NEXUS-MCP''' + #13#10 +
      '$end = ''# END NEXUS-MCP''' + #13#10 +
      '$codexOk = (Test-Path $cfg) -or (Test-Path (Join-Path $env:LOCALAPPDATA ''Programs\Codex\Codex.exe'')) -or (Test-Path (Join-Path $env:LOCALAPPDATA ''Codex\Codex.exe'')) -or ($null -ne (Get-Command codex -EA SilentlyContinue))' + #13#10 +
      'if (-not $codexOk) { exit 10 }' + #13#10 +
      'if ((Test-Path $cfg) -and ([System.IO.File]::ReadAllText($cfg) -match ([regex]::Escape($begin) + ''|(?m)^\s*\[mcp_servers\.nexus\]''))) { exit 20 }' + #13#10 +
      'if (-not (Test-Path $tomlSrc)) { exit 10 }' + #13#10 +
      '$toml = [System.IO.File]::ReadAllText($tomlSrc, [System.Text.Encoding]::UTF8).TrimEnd()' + #13#10 +
      '$tomlBlock = $begin + [Environment]::NewLine + $toml + [Environment]::NewLine + $end + [Environment]::NewLine' + #13#10 +
      '$cfgDir = Split-Path $cfg -Parent' + #13#10 +
      'if (-not (Test-Path $cfgDir)) { New-Item -ItemType Directory -Force -Path $cfgDir | Out-Null }' + #13#10 +
      'if (Test-Path $cfg) { $existing = [System.IO.File]::ReadAllText($cfg, [System.Text.Encoding]::UTF8).TrimEnd(); $newText = $existing + [Environment]::NewLine + [Environment]::NewLine + $tomlBlock } else { $newText = $tomlBlock }' + #13#10 +
      '[System.IO.File]::WriteAllText($cfg, $newText, [System.Text.UTF8Encoding]::new($false))' + #13#10 +
      'exit 0' + #13#10;
    SavePowerShellScript(Dir + '\connect-codex-desktop.ps1', CodexScript);
    CodexCmd :=
      '@echo off' + #13#10 +
      '"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%~dp0connect-codex-desktop.ps1"' + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-codex-desktop.cmd', CodexCmd, False);
  end;
end;

{ Removal scripts for every client, whatever this run selected: uninstall must be
  able to remove an entry this installer adopted (see AdoptConfiguredClients), not
  only one it wrote. Each script exits 0 when the client or its entry is absent; the
  JSON ones remove the entry from every readable file and exit 1 when one is not a
  JSON object, leaving that file unchanged. }
procedure WriteDisconnectScripts;
var
  Dir: String;
begin
  if not AssistantIntegrationAvailable() then exit;
  Dir := ExpandConstant('{app}\integrations');
  ForceDirectories(Dir);
  WriteJsonHelper(Dir);

  { Same resolution as connect-copilot-cli.ps1: `cmd /c copilot` may reach another
    launcher (an editor shim) first on PATH. }
  SavePowerShellScript(Dir + '\disconnect-copilot-cli.ps1',
    '$c = Get-Command copilot -EA SilentlyContinue | Select-Object -First 1' + #13#10 +
    'if (-not $c -or ($c.CommandType -notin @(''Application'', ''ExternalScript''))) { exit 0 }' + #13#10 +
    '& $c.Source mcp remove nexus *> $null' + #13#10 +
    'exit 0' + #13#10);
  SavePowerShellScript(Dir + '\disconnect-copilot-jetbrains.ps1',
    '$ErrorActionPreference = ''Stop''' + #13#10 +
    'trap { Write-Host (''NEXUS: '' + $_.Exception.Message); exit 1 }' + #13#10 +
    '. (Join-Path $PSScriptRoot ''nexus-json.ps1'')' + #13#10 +
    '$mcp = Join-Path $env:LOCALAPPDATA ''github-copilot\intellij\mcp.json''' + #13#10 +
    'Remove-NexusServerEntry @($mcp) ''servers''' + #13#10 +
    'exit 0' + #13#10);
  SavePowerShellScript(Dir + '\disconnect-claude-desktop.ps1',
    '$ErrorActionPreference = ''Stop''' + #13#10 +
    'trap { Write-Host (''NEXUS: '' + $_.Exception.Message); exit 1 }' + #13#10 +
    '. (Join-Path $PSScriptRoot ''nexus-json.ps1'')' + #13#10 +
    ClaudeDesktopConfigsPs() +
    ClaudeDesktopClosedGuardPs() +
    'Remove-NexusServerEntry $cfgs ''mcpServers''' + #13#10 +
    'exit 0' + #13#10);
  SavePowerShellScript(Dir + '\disconnect-claude-cli.ps1',
    ClaudeCliResolverPs() +
    '& $exe mcp remove --scope user nexus *> $null' + #13#10 +
    'exit 0' + #13#10);
  SavePowerShellScript(Dir + '\disconnect-codex-cli.ps1',
    '$c = Get-Command codex -EA SilentlyContinue | Select-Object -First 1' + #13#10 +
    'if (-not $c -or ($c.CommandType -notin @(''Application'', ''ExternalScript''))) { exit 0 }' + #13#10 +
    '& $c.Source mcp remove nexus *> $null' + #13#10 +
    'exit 0' + #13#10);
  SavePowerShellScript(Dir + '\disconnect-codex-desktop.ps1',
    '$cfg = Join-Path $env:USERPROFILE ''.codex\config.toml''' + #13#10 +
    'if (-not (Test-Path $cfg)) { exit 0 }' + #13#10 +
    '$begin = ''# BEGIN NEXUS-MCP''' + #13#10 +
    '$end = ''# END NEXUS-MCP''' + #13#10 +
    '$text = [System.IO.File]::ReadAllText($cfg, [System.Text.Encoding]::UTF8)' + #13#10 +
    'if ($text -notmatch [regex]::Escape($begin)) { exit 0 }' + #13#10 +
    '$pat = ''(?s)'' + [regex]::Escape($begin) + ''.*?'' + [regex]::Escape($end) + ''\r?\n?''' + #13#10 +
    '$cleaned = ([regex]::Replace($text, $pat, '''')).TrimEnd()' + #13#10 +
    '$out = ''''' + #13#10 +
    'if ($cleaned) { $out = $cleaned + [Environment]::NewLine }' + #13#10 +
    '[System.IO.File]::WriteAllText($cfg, $out, [System.Text.UTF8Encoding]::new($false))' + #13#10 +
    'exit 0' + #13#10);
end;

function ClientRegistryName(Index: Integer): String;
begin
  case Index of
    CLIENT_COPILOT_CLI: Result := 'CopilotCliManaged';
    CLIENT_COPILOT_JETBRAINS: Result := 'CopilotJetBrainsManaged';
    CLIENT_CLAUDE_CODE: Result := 'ClaudeCliManaged';
    CLIENT_CLAUDE_DESKTOP: Result := 'ClaudeDesktopManaged';
    CLIENT_CODEX_CLI: Result := 'CodexCliManaged';
    CLIENT_CODEX_DESKTOP: Result := 'CodexManaged';
  else
    Result := '';
  end;
end;

{ A client shown "déjà configuré" whose nexus entry launches NEXUS (nexus-mcp.cmd or
  nexus-mcp.jar) is marked managed, so uninstall removes it like an entry this run
  wrote. A nexus entry that launches anything else is left to its owner. }
procedure AdoptConfiguredClients;
var
  I: Integer;
begin
  if IsSmokeBuild() or (not AssistantIntegrationAvailable()) then exit;
  for I := 0 to CLIENT_GENERIC - 1 do
    if ClientConfigured[I] and ClientOwned[I] then
    begin
      RegWriteStringValue(HKCU, InstallerRegistryPath(), ClientRegistryName(I), '1');
      Log('Existing NEXUS MCP entry adopted for ' + ClientSection(I));
    end;
end;

{ Returns the connect script's exit code: 0 connected, 20 entry already present,
  10 client not found, anything else a failure (-1 when the script cannot run). }
function RunManagedIntegration(ScriptName: String; RegistryName: String): Integer;
var
  ResultCode: Integer;
  ScriptPath: String;
begin
  Result := -1;
  ScriptPath := ExpandConstant('{app}\integrations\') + ScriptName;
  if not FileExists(ScriptPath) then exit;
  if Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ScriptPath + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    Result := ResultCode;
    if ResultCode = 0 then RegWriteStringValue(HKCU, InstallerRegistryPath(), RegistryName, '1')
    else if ResultCode = 20 then Log(ScriptName + ': existing NEXUS MCP entry preserved')
    else if ResultCode = 10 then Log(ScriptName + ': client not detected; generated integration asset kept for later')
    else Log(ScriptName + ': integration command exited with code ' + IntToStr(ResultCode));
  end;
end;

procedure ReportIntegration(Index: Integer; ExitCode: Integer; var Failed: String);
begin
  if (ExitCode = 0) or (ExitCode = 20) then exit;
  if ExitCode = 10 then
    Failed := Failed + '  • ' + ClientLabel(Index) + ' — client introuvable' + #13#10
  else if ExitCode = 30 then
    Failed := Failed + '  • ' + ClientLabel(Index) + ' — application restée ouverte ; relancez integrations\connect-claude-desktop.cmd après l''avoir quittée' + #13#10
  else
    Failed := Failed + '  • ' + ClientLabel(Index) + ' — code ' + IntToStr(ExitCode) + #13#10;
end;

procedure PersistSettings;
begin
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', DeploymentPage.SelectedValueIndex);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', RuntimePage.Values[0]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', RuntimePage.Values[1]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', RuntimePage.Values[2]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', RuntimePage.Values[3]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', SemanticProviderValue());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', OllamaPage.Values[0]);
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'OllamaAutoInstall', Ord(OllamaPrereqPage.Values[0]));
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'DockerAutoInstall', Ord(DockerPrereqPage.Values[0]));
  if InstallDocker() then
  begin
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', DockerPage.Values[0]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', DockerPage.Values[1]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', DockerPage.Values[2]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', DockerPage.Values[3]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', DockerPage.Values[4]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', DockerPage.Values[5]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', DockerPage.Values[6]);
  end;
end;

function DeploymentModeLabel(): String;
begin
  if DeploymentPage.SelectedValueIndex = 0 then Result := 'Natif Windows'
  else if DeploymentPage.SelectedValueIndex = 1 then Result := 'Docker'
  else Result := 'Natif + Docker';
end;

function ProfileLabel(): String;
begin
  if IsCustomProfile() then Result := 'Personnalisé' else Result := 'Recommandé';
end;

function IntegrationRuntimeLabel(): String;
begin
  if UseDockerForIntegrations() then Result := 'Docker / docker exec -i'
  else Result := 'Natif / Java embarqué';
end;

function DockerPrerequisiteSummary(NewLine: String): String;
begin
  Result := '';
  if not InstallDocker() then exit;
  if DockerRuntimePresent() then
    Result := '  - Docker Desktop/CLI : détecté' + NewLine
  else if DockerDesktopAutoInstallSelected() then
    Result := '  - Docker Desktop : sera téléchargé depuis desktop.docker.com et installé en mode utilisateur (WSL 2)' + NewLine +
      '  - La licence Docker devra être acceptée par l''utilisateur au premier démarrage ; NEXUS ne l''accepte pas automatiquement.' + NewLine
  else
    Result := '  - Docker Desktop/CLI : absent' + NewLine;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo, MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
var
  I: Integer;
begin
  Result := 'RÉCAPITULATIF NEXUS' + NewLine + NewLine +
    'Mode : ' + DeploymentModeLabel() + NewLine +
    'Profil : ' + ProfileLabel() + NewLine +
    'Répertoire : ' + WizardDirValue() + NewLine +
    'NEXUS_HOME : ' + RuntimePage.Values[0] + NewLine;

  if InstallNative() then
  begin
    Result := Result + NewLine + 'Natif :' + NewLine;
    if InstallNativeCli() then Result := Result + '  - CLI NEXUS' + NewLine;
    if InstallNativeMcp() then Result := Result + '  - Serveur MCP STDIO' + NewLine;
    if InstallNativeRest() then Result := Result + '  - REST ' + RuntimePage.Values[1] + ':' + RuntimePage.Values[2] + ' (port externe vérifié)' + NewLine;
    if WizardIsTaskSelected('addtopath') then Result := Result + '  - Ajouter NEXUS au PATH utilisateur' + NewLine;
  end;

  if OllamaEnabled() then
  begin
    Result := Result + NewLine + 'Recherche sémantique : Ollama ACTIVÉ' + NewLine;
    // Endpoints réellement retenus par runtime. En mode Both, le natif joint Ollama en direct
    // tandis que le conteneur Docker passe par host.docker.internal (résolu depuis l'URL saisie).
    if InstallNative() then
      Result := Result + '  - URL (Natif) : ' + OllamaPage.Values[0] + NewLine;
    if InstallDocker() then
      Result := Result + '  - URL (Docker) : ' + OllamaUrlForDocker(OllamaPage.Values[0]) + NewLine;
    if OllamaPresent() then
      Result := Result + '  - Ollama : détecté sur ce système (aucun téléchargement).' + NewLine
    else if OllamaAutoInstallSelected() then
      Result := Result + '  - Ollama : sera TÉLÉCHARGÉ depuis ollama.com puis INSTALLÉ (signature Authenticode vérifiée) avant NEXUS.' + NewLine
    else
      Result := Result + '  - Ollama : absent — installation automatique désactivée. Installez Ollama manuellement avant de démarrer NEXUS.' + NewLine;
  end
  else
    Result := Result + NewLine + 'Recherche sémantique : désactivée (aucun téléchargement Ollama)' + NewLine;

  if InstallDocker() then
  begin
    Result := Result + NewLine + 'Docker :' + NewLine + DockerPrerequisiteSummary(NewLine) +
      '  - Image : ' + DockerPage.Values[0] + NewLine +
      '  - Conteneur : ' + DockerPage.Values[1] + NewLine +
      '  - REST : ' + DockerPage.Values[2] + ':' + DockerPage.Values[3] + ' (port hôte vérifié) -> conteneur:' + DockerPage.Values[4] + NewLine +
      '  - Repository : ' + DockerPage.Values[5] + ' -> /workspace:ro' + NewLine +
      '  - Restart policy : ' + DockerPage.Values[6] + NewLine;
    if WizardIsTaskSelected('startdocker') then Result := Result + '  - Démarrage Docker après installation' + NewLine;
  end;

  Result := Result + NewLine + 'Clients IA :' + NewLine;
  if AssistantIntegrationAvailable() then
  begin
    for I := 0 to CLIENT_COUNT - 1 do
      if ClientSelected(I) then
        Result := Result + '  - ' + ClientLabel(I) + NewLine
      else if ClientConfigured[I] then
        Result := Result + '  - ' + ClientLabel(I) + ' (déjà configuré, inchangé)' + NewLine;
    if HasAssistantSelection() then
      Result := Result + '  - Runtime MCP : ' + IntegrationRuntimeLabel() + NewLine
    else
      Result := Result + '  - Aucun nouveau client à connecter' + NewLine;
  end
  else
    Result := Result + '  - Indisponible sans serveur MCP installé' + NewLine;

  Result := Result + NewLine + 'Cliquez sur Installer pour appliquer exactement cette configuration.';
end;

procedure StartDockerDesktopAfterInstall;
var
  DockerDesktopPath: String;
  ResultCode: Integer;
begin
  if not DockerDesktopInstalledDuringSetup then exit;
  DockerDesktopPath := DockerDesktopExecutable();
  if DockerDesktopPath = '' then exit;
  if Exec(DockerDesktopPath, '', '', SW_SHOWNORMAL, ewNoWait, ResultCode) then
    MsgBox(
      'Docker Desktop a été installé et vient d''être lancé.' + #13#10 +
      'Au premier démarrage, acceptez les conditions Docker et terminez si nécessaire la préparation WSL 2. ' +
      'Le script NEXUS Docker attendra ensuite que le moteur soit prêt.',
      mbInformation, MB_OK);
end;

{ Post-install progress: one row per configuration step the wizard choices trigger,
  under Inno's own (already full) file-copy gauge. Every step is a separate call made
  here, so this code sets each row's state itself around the call. }
type
  TSetupStepRow = record
    Id: String;
    Caption: String;
    Detail: String;
    State: String;
    StateLabel: TNewStaticText;
    Bar: TNewProgressBar;
  end;

var
  SetupStepRows: array of TSetupStepRow;

function SetupStepRowIndex(Id: String): Integer;
var
  I: Integer;
begin
  Result := -1;
  for I := 0 to GetArrayLength(SetupStepRows) - 1 do
    if SetupStepRows[I].Id = Id then
    begin
      Result := I;
      exit;
    end;
end;

procedure AddSetupStepRow(Id, Caption: String);
var
  I: Integer;
begin
  I := GetArrayLength(SetupStepRows);
  SetArrayLength(SetupStepRows, I + 1);
  SetupStepRows[I].Id := Id;
  SetupStepRows[I].Caption := Caption;
  SetupStepRows[I].Detail := '';
  SetupStepRows[I].State := 'pending';
end;

{ The bar carries the state: running is indeterminate (marquee), done is full and
  green, skipped is full and paused, failed is full and red, pending and not run
  are empty. The label names the step, followed by the outcome detail if any. }
procedure RenderSetupStepRow(Index: Integer);
var
  Row: TSetupStepRow;
begin
  Row := SetupStepRows[Index];
  if Row.Bar = nil then exit;
  Row.Bar.Style := npbstNormal;
  Row.Bar.State := npbsNormal;
  if Row.State = 'running' then
    Row.Bar.Style := npbstMarquee
  else if Row.State = 'done' then
    Row.Bar.Position := 100
  else if Row.State = 'skipped' then
  begin
    Row.Bar.Position := 100;
    Row.Bar.State := npbsPaused;
  end
  else if Row.State = 'failed' then
  begin
    Row.Bar.Position := 100;
    Row.Bar.State := npbsError;
  end
  else
    Row.Bar.Position := 0;
  if Row.Detail <> '' then
    Row.StateLabel.Caption := Row.Caption + ' — ' + Row.Detail
  else
    Row.StateLabel.Caption := Row.Caption;
end;

procedure SetSetupStepState(Id, State, Detail: String);
var
  I: Integer;
begin
  I := SetupStepRowIndex(Id);
  if I < 0 then exit;
  if SetupStepRows[I].State <> State then Log('Setup progress: ' + Id + ' ' + State);
  SetupStepRows[I].State := State;
  SetupStepRows[I].Detail := Detail;
  RenderSetupStepRow(I);
  { Paint the new state now: a step without an external process never lets the
    message loop run before the next one starts. }
  WizardForm.InstallingPage.Update;
end;

{ Label on the left, bar on the right; rows shrink when every selected step
  would not fit at the default height. }
procedure LayoutSetupStepRows;
var
  I: Integer;
  Count: Integer;
  Top: Integer;
  RowHeight: Integer;
  BarHeight: Integer;
  LabelWidth: Integer;
  StateLabel: TNewStaticText;
  Bar: TNewProgressBar;
begin
  Count := GetArrayLength(SetupStepRows);
  if Count = 0 then exit;
  Top := WizardForm.ProgressGauge.Top + WizardForm.ProgressGauge.Height + ScaleY(12);
  RowHeight := ScaleY(20);
  if RowHeight * Count > WizardForm.InstallingPage.Height - Top then
    RowHeight := (WizardForm.InstallingPage.Height - Top) div Count;
  BarHeight := ScaleY(14);
  if BarHeight > RowHeight - ScaleY(2) then BarHeight := RowHeight - ScaleY(2);
  LabelWidth := (WizardForm.ProgressGauge.Width * 3) div 5;
  for I := 0 to Count - 1 do
  begin
    StateLabel := TNewStaticText.Create(WizardForm);
    StateLabel.Parent := WizardForm.InstallingPage;
    StateLabel.AutoSize := False;
    StateLabel.WordWrap := False;
    StateLabel.Left := WizardForm.ProgressGauge.Left;
    StateLabel.Top := Top + I * RowHeight + (RowHeight - BarHeight) div 2;
    StateLabel.Width := LabelWidth - ScaleX(8);
    StateLabel.Height := RowHeight;
    Bar := TNewProgressBar.Create(WizardForm);
    Bar.Parent := WizardForm.InstallingPage;
    Bar.Left := WizardForm.ProgressGauge.Left + LabelWidth;
    Bar.Top := Top + I * RowHeight + (RowHeight - BarHeight) div 2;
    Bar.Width := WizardForm.ProgressGauge.Width - LabelWidth;
    Bar.Height := BarHeight;
    Bar.Min := 0;
    Bar.Max := 100;
    SetupStepRows[I].StateLabel := StateLabel;
    SetupStepRows[I].Bar := Bar;
    RenderSetupStepRow(I);
  end;
end;

{ One row per step, under the same conditions as the calls in CurStepChanged;
  none in smoke builds, where assistant integrations never run. }
procedure BuildSetupStepRows;
var
  I: Integer;
begin
  if IsSmokeBuild() then exit;
  AddSetupStepRow('config', 'Configuration NEXUS');
  if HasAssistantSelection() then
    AddSetupStepRow('assets', 'Scripts d''intégration des clients IA');
  if DockerDesktopInstalledDuringSetup then
    AddSetupStepRow('docker-desktop', 'Lancement de Docker Desktop');
  for I := 0 to CLIENT_GENERIC - 1 do
    if ClientSelected(I) then AddSetupStepRow(ClientSection(I), 'Client ' + ClientLabel(I));
  LayoutSetupStepRows;
end;

procedure ConnectClient(Index: Integer; ScriptName: String; RegistryName: String; var Failed: String);
var
  ExitCode: Integer;
begin
  if not ClientSelected(Index) then exit;
  SetSetupStepState(ClientSection(Index), 'running', '');
  if Index = CLIENT_CLAUDE_DESKTOP then
    ExitCode := RunWhileClaudeDesktopClosed(ExpandConstant('{app}\integrations\connect-claude-desktop.ps1'), RegistryName, False)
  else
    ExitCode := RunManagedIntegration(ScriptName, RegistryName);
  if ExitCode = 0 then
    SetSetupStepState(ClientSection(Index), 'done', 'connecté')
  else if ExitCode = 20 then
    SetSetupStepState(ClientSection(Index), 'skipped', 'entrée nexus déjà présente')
  else if ExitCode = 10 then
    SetSetupStepState(ClientSection(Index), 'failed', 'client introuvable')
  else if ExitCode = 30 then
    SetSetupStepState(ClientSection(Index), 'failed', 'application ouverte')
  else
    SetSetupStepState(ClientSection(Index), 'failed', 'code ' + IntToStr(ExitCode));
  ReportIntegration(Index, ExitCode, Failed);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Failed: String;
begin
  if CurStep = ssPostInstall then
  begin
    BuildSetupStepRows;
    SetSetupStepState('config', 'running', '');
    WriteNativeConfiguration;
    WriteDockerConfiguration;
    AddNexusToUserPath;
    PersistSettings;
    SetSetupStepState('config', 'done', '');
    WriteDisconnectScripts;
    AdoptConfiguredClients;
    if HasAssistantSelection() then
    begin
      SetSetupStepState('assets', 'running', '');
      WriteAssistantAssets;
      SetSetupStepState('assets', 'done', '');
    end;
    if DockerDesktopInstalledDuringSetup then
    begin
      SetSetupStepState('docker-desktop', 'running', '');
      StartDockerDesktopAfterInstall;
      SetSetupStepState('docker-desktop', 'done', '');
    end;
    if (not IsSmokeBuild()) and HasAssistantSelection() then
    begin
      Failed := '';
      ConnectClient(CLIENT_COPILOT_CLI, 'connect-copilot-cli.cmd', 'CopilotCliManaged', Failed);
      ConnectClient(CLIENT_COPILOT_JETBRAINS, 'connect-copilot-jetbrains.cmd', 'CopilotJetBrainsManaged', Failed);
      ConnectClient(CLIENT_CLAUDE_CODE, 'connect-claude-cli.cmd', 'ClaudeCliManaged', Failed);
      ConnectClient(CLIENT_CLAUDE_DESKTOP, 'connect-claude-desktop.cmd', 'ClaudeDesktopManaged', Failed);
      ConnectClient(CLIENT_CODEX_CLI, 'connect-codex-cli.cmd', 'CodexCliManaged', Failed);
      ConnectClient(CLIENT_CODEX_DESKTOP, 'connect-codex-desktop.cmd', 'CodexManaged', Failed);
      if (Failed <> '') and (not WizardSilent()) then
        MsgBox('NEXUS est installé, mais ces clients IA n''ont pas pu être connectés :' + #13#10 + Failed + #13#10 +
          'Les scripts de connexion restent dans ' + ExpandConstant('{app}\integrations') + '.' + #13#10 +
          'Détails : journal d''installation (option /LOG).', mbError, MB_OK);
    end;
  end;
end;

procedure RemoveManagedAssistantIntegrations;
var
  Value: String;
  ResultCode: Integer;
  PsExe: String;
begin
  PsExe := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged', Value) and (Value = '1') then
  begin
    if FileExists(ExpandConstant('{app}\integrations\disconnect-copilot-cli.ps1')) then
      Exec(PsExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\integrations\disconnect-copilot-cli.ps1') + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)
    else if CommandExists('copilot') then
      Exec(ExpandConstant('{cmd}'), '/D /S /C "copilot mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CopilotJetBrainsManaged', Value) and (Value = '1') and
     FileExists(ExpandConstant('{app}\integrations\disconnect-copilot-jetbrains.ps1')) then
  begin
    { The managed flag survives a failed removal, so that a later uninstall retries it. }
    if Exec(PsExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\integrations\disconnect-copilot-jetbrains.ps1') + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0) then
      RegDeleteValue(HKCU, InstallerRegistryPath(), 'CopilotJetBrainsManaged')
    else
      Log('disconnect-copilot-jetbrains.ps1: mcp.json left unchanged, exit code ' + IntToStr(ResultCode));
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ClaudeDesktopManaged', Value) and (Value = '1') and
     FileExists(ExpandConstant('{app}\integrations\disconnect-claude-desktop.ps1')) then
  begin
    ResultCode := RunWhileClaudeDesktopClosed(ExpandConstant('{app}\integrations\disconnect-claude-desktop.ps1'), '', True);
    if ResultCode = 0 then
      RegDeleteValue(HKCU, InstallerRegistryPath(), 'ClaudeDesktopManaged')
    else
      Log('disconnect-claude-desktop.ps1: a Claude Desktop configuration kept its nexus entry, exit code ' + IntToStr(ResultCode));
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ClaudeCliManaged', Value) and (Value = '1') then
  begin
    if FileExists(ExpandConstant('{app}\integrations\disconnect-claude-cli.ps1')) then
      Exec(PsExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\integrations\disconnect-claude-cli.ps1') + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode)
    else if CommandExists('claude') then
      Exec(ExpandConstant('{cmd}'), '/D /S /C "claude mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ClaudeCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CodexCliManaged', Value) and (Value = '1') and
     FileExists(ExpandConstant('{app}\integrations\disconnect-codex-cli.ps1')) then
  begin
    Exec(PsExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\integrations\disconnect-codex-cli.ps1') + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CodexCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CodexManaged', Value) and (Value = '1') and
     FileExists(ExpandConstant('{app}\integrations\disconnect-codex-desktop.ps1')) then
  begin
    Exec(PsExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{app}\integrations\disconnect-codex-desktop.ps1') + '"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CodexManaged');
  end;
end;

procedure StopManagedDocker;
var
  Value: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', Value) and (Value = '1') and FileExists(ExpandConstant('{app}\nexus-docker-down.cmd')) then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ExpandConstant('{app}\nexus-docker-down.cmd') + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'DockerManaged');
  end;
end;

function InitializeUninstall(): Boolean;
var
  i: Integer;
begin
  UninstSilent := False;
  for i := 1 to ParamCount do
    if (UpperCase(ParamStr(i)) = '/VERYSILENT') or (UpperCase(ParamStr(i)) = '/SILENT') then
    begin
      UninstSilent := True;
      break;
    end;
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    StopManagedDocker;
    RemoveManagedAssistantIntegrations;
    RemoveNexusFromUserPath;
    { NEXUS_HOME and Docker Desktop are intentionally preserved. }
  end;
  if CurUninstallStep = usPostUninstall then
  begin
    { Remove files and directories not tracked by Inno Setup: installer-generated
      nexus-docker-up/down.cmd, docker/.env + docker-compose.yml, and
      empty lib/ rest/ dirs. }
    DeleteFile(ExpandConstant('{app}\nexus-docker-up.cmd'));
    DeleteFile(ExpandConstant('{app}\nexus-docker-down.cmd'));
    DelTree(ExpandConstant('{app}\docker'), True, True, True);
    RemoveDir(ExpandConstant('{app}\lib'));
    RemoveDir(ExpandConstant('{app}\rest'));
    { Offer to remove user configuration data (interactive mode only;
      silent uninstall preserves these directories). }
    if not UninstSilent then
    begin
      if DirExists(ExpandConstant('{app}\config')) or DirExists(ExpandConstant('{app}\integrations')) then
      begin
        if MsgBox(
          'Supprimer les données de configuration NEXUS ?' + #13#10 +
          '  • ' + ExpandConstant('{app}\config') + #13#10 +
          '  • ' + ExpandConstant('{app}\integrations') + #13#10 + #13#10 +
          'Ces dossiers ne seront pas récupérables.',
          mbConfirmation, MB_YESNO) = IDYES then
        begin
          DelTree(ExpandConstant('{app}\config'), True, True, True);
          DelTree(ExpandConstant('{app}\integrations'), True, True, True);
        end;
      end;
    end;
    RemoveDir(ExpandConstant('{app}'));
  end;
end;