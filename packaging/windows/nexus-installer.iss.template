function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = NativeOptionsPage.ID then Result := (not InstallNative()) or (not IsCustomProfile())
  else if PageID = RuntimePage.ID then Result := not IsCustomProfile()
  else if PageID = DockerPage.ID then Result := not InstallDocker()
  else if PageID = AssistantPage.ID then Result := (not InstallNativeMcp()) and (not InstallDocker())
  else if PageID = IntegrationRuntimePage.ID then Result := not (InstallNative() and InstallDocker());
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortValue: Integer;
begin
  Result := True;

  if (CurPageID = NativeOptionsPage.ID) and InstallNative() then
  begin
    if not (NativeOptionsPage.Values[0] or NativeOptionsPage.Values[1] or NativeOptionsPage.Values[2]) then
    begin
      MsgBox('Sélectionnez au moins une surface native.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = RuntimePage.ID then
  begin
    if Trim(RuntimePage.Values[0]) = '' then
    begin
      MsgBox('NEXUS_HOME ne peut pas être vide.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(RuntimePage.Values[2], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST natif doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if InstallNativeRest() and (RuntimePage.Values[1] <> '127.0.0.1') and (RuntimePage.Values[1] <> 'localhost') and (Trim(RuntimePage.Values[3]) = '') then
    begin
      MsgBox('Un token API REST est obligatoire pour une écoute native non-loopback.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = DockerPage.ID then
  begin
    if not CommandExists('docker') then
    begin
      MsgBox('Docker CLI/Engine n''est pas disponible. Installez ou démarrez Docker Desktop/Engine avant de choisir le mode Docker.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if (Trim(DockerPage.Values[0]) = '') or (Trim(DockerPage.Values[1]) = '') or (Trim(DockerPage.Values[5]) = '') then
    begin
      MsgBox('Image, nom du conteneur et repository Docker sont obligatoires.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(DockerPage.Values[3], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST hôte Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(DockerPage.Values[4], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST interne Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;
end;

procedure WriteNativeConfiguration;
var
  Content: String;
begin
  if not InstallNative() then exit;
  ForceDirectories(ExpandConstant('{app}\config'));
  Content := '@echo off' + #13#10 +
    'set "NEXUS_HOME=' + RuntimePage.Values[0] + '"' + #13#10 +
    'set "NEXUS_REST_HOST=' + RuntimePage.Values[1] + '"' + #13#10 +
    'set "NEXUS_REST_PORT=' + RuntimePage.Values[2] + '"' + #13#10 +
    'set "NEXUS_REST_API_TOKEN=' + RuntimePage.Values[3] + '"' + #13#10 +
    'set "NEXUS_SEMANTIC_PROVIDER=' + RuntimePage.Values[4] + '"' + #13#10 +
    'set "NEXUS_OLLAMA_BASE_URL=' + RuntimePage.Values[5] + '"' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\config\nexus-native.env.cmd'), Content, False);
end;

procedure WriteDockerConfiguration;
var
  EnvContent: String;
  ComposeTemplate: AnsiString;
  DockerToken: String;
  UpScript: String;
  DownScript: String;
begin
  if not InstallDocker() then exit;
  ForceDirectories(ExpandConstant('{app}\docker'));
  DockerToken := RuntimePage.Values[3];
  if Trim(DockerToken) = '' then DockerToken := GenerateLocalToken();

  EnvContent :=
    'NEXUS_DOCKER_IMAGE=' + DockerPage.Values[0] + #13#10 +
    'NEXUS_DOCKER_CONTAINER=' + DockerPage.Values[1] + #13#10 +
    'NEXUS_DOCKER_RESTART_POLICY=' + DockerPage.Values[6] + #13#10 +
    'NEXUS_DOCKER_BIND_ADDRESS=' + DockerPage.Values[2] + #13#10 +
    'NEXUS_DOCKER_HOST_PORT=' + DockerPage.Values[3] + #13#10 +
    'NEXUS_DOCKER_CONTAINER_PORT=' + DockerPage.Values[4] + #13#10 +
    'NEXUS_HOME_BIND=' + DockerPath(RuntimePage.Values[0]) + #13#10 +
    'NEXUS_REPOSITORY_BIND=' + DockerPath(DockerPage.Values[5]) + #13#10 +
    'NEXUS_SEMANTIC_PROVIDER=' + RuntimePage.Values[4] + #13#10 +
    'NEXUS_OLLAMA_BASE_URL=' + RuntimePage.Values[5] + #13#10 +
    'NEXUS_REST_API_TOKEN=' + DockerToken + #13#10;
  SaveStringToFile(ExpandConstant('{app}\docker\.env'), EnvContent, False);

  if not LoadStringFromFile(ExpandConstant('{app}\docker\docker-compose.yml.template'), ComposeTemplate) then
    RaiseException('Impossible de lire la template Docker Compose installée.');
  SaveStringToFile(ExpandConstant('{app}\docker\docker-compose.yml'), ComposeTemplate, False);

  UpScript := '@echo off' + #13#10 + 'setlocal' + #13#10 +
    'docker compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" up -d' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  DownScript := '@echo off' + #13#10 + 'setlocal' + #13#10 +
    'docker compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" down' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-up.cmd'), UpScript, False);
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-down.cmd'), DownScript, False);

  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', '1');
end;

function NativeMcpCommandJson(ServersKey: String): String;
var
  JavaPath: String;
  RunnerPath: String;
begin
  JavaPath := JsonEscape(ExpandConstant('{app}\app\runtime\bin\java.exe'));
  RunnerPath := JsonEscape(ExpandConstant('{app}\lib\nexus-mcp.jar'));
  Result := '{' + #13#10 +
    '  "' + ServersKey + '": {' + #13#10 +
    '    "nexus": {' + #13#10 +
    '      "type": "stdio",' + #13#10 +
    '      "command": "' + JavaPath + '",' + #13#10 +
    '      "args": ["-jar", "' + RunnerPath + '"]' + #13#10 +
    '    }' + #13#10 +
    '  }' + #13#10 +
    '}' + #13#10;
end;

function DockerMcpCommandJson(ServersKey: String): String;
begin
  Result := '{' + #13#10 +
    '  "' + ServersKey + '": {' + #13#10 +
    '    "nexus": {' + #13#10 +
    '      "type": "stdio",' + #13#10 +
    '      "command": "docker",' + #13#10 +
    '      "args": ["exec", "-i", "' + JsonEscape(DockerPage.Values[1]) + '", "java", "-jar", "/opt/nexus/lib/nexus-mcp.jar"]' + #13#10 +
    '    }' + #13#10 +
    '  }' + #13#10 +
    '}' + #13#10;
end;

procedure WriteAssistantAssets;
var
  Dir: String;
  CopilotScript: String;
  ClaudeScript: String;
  CommandTail: String;
begin
  if not HasAssistantSelection() then exit;
  Dir := ExpandConstant('{app}\integrations');
  ForceDirectories(Dir);

  if UseDockerForIntegrations() then
    CommandTail := 'docker exec -i "' + DockerPage.Values[1] + '" java -jar /opt/nexus/lib/nexus-mcp.jar'
  else
    CommandTail := '"' + ExpandConstant('{app}\app\runtime\bin\java.exe') + '" -jar "' + ExpandConstant('{app}\lib\nexus-mcp.jar') + '"';

  if AssistantPage.Values[1] then
  begin
    if UseDockerForIntegrations() then
      SaveStringToFile(Dir + '\copilot-jetbrains.mcp.json', DockerMcpCommandJson('servers'), False)
    else
      SaveStringToFile(Dir + '\copilot-jetbrains.mcp.json', NativeMcpCommandJson('servers'), False);
  end;

  if AssistantPage.Values[3] then
  begin
    if UseDockerForIntegrations() then
      SaveStringToFile(Dir + '\generic-mcp.json', DockerMcpCommandJson('mcpServers'), False)
    else
      SaveStringToFile(Dir + '\generic-mcp.json', NativeMcpCommandJson('mcpServers'), False);
  end;

  if AssistantPage.Values[0] then
  begin
    CopilotScript := '@echo off' + #13#10 +
      'where copilot >nul 2>nul || exit /b 10' + #13#10 +
      'copilot mcp get nexus >nul 2>nul && exit /b 20' + #13#10 +
      'copilot mcp add nexus --tools "*" -- ' + CommandTail + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-copilot-cli.cmd', CopilotScript, False);
  end;

  if AssistantPage.Values[2] then
  begin
    ClaudeScript := '@echo off' + #13#10 +
      'where claude >nul 2>nul || exit /b 10' + #13#10 +
      'claude mcp get nexus >nul 2>nul && exit /b 20' + #13#10 +
      'claude mcp add nexus --scope user -- ' + CommandTail + #13#10 +
      'exit /b %ERRORLEVEL%' + #13#10;
    SaveStringToFile(Dir + '\connect-claude-user.cmd', ClaudeScript, False);
  end;
end;

procedure RunManagedIntegration(ScriptName: String; RegistryName: String);
var
  ResultCode: Integer;
  ScriptPath: String;
begin
  ScriptPath := ExpandConstant('{app}\integrations\') + ScriptName;
  if not FileExists(ScriptPath) then exit;
  if Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ScriptPath + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode) then
  begin
    if ResultCode = 0 then RegWriteStringValue(HKCU, InstallerRegistryPath(), RegistryName, '1')
    else if ResultCode = 20 then Log(ScriptName + ': existing NEXUS MCP entry preserved')
    else if ResultCode = 10 then Log(ScriptName + ': client CLI not detected; generated integration asset kept for later')
    else Log(ScriptName + ': integration command exited with code ' + IntToStr(ResultCode));
  end;
end;

procedure PersistSettings;
begin
  RegWriteDWordValue(HKCU, InstallerRegistryPath(), 'DeploymentMode', DeploymentPage.SelectedValueIndex);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NexusHome', RuntimePage.Values[0]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestHost', RuntimePage.Values[1]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'NativeRestPort', RuntimePage.Values[2]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'RestApiToken', RuntimePage.Values[3]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', RuntimePage.Values[4]);
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'OllamaBaseUrl', RuntimePage.Values[5]);
  if InstallDocker() then
  begin
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerImage', DockerPage.Values[0]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainer', DockerPage.Values[1]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerBindAddress', DockerPage.Values[2]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerHostPort', DockerPage.Values[3]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerContainerPort', DockerPage.Values[4]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRepository', DockerPage.Values[5]);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerRestartPolicy', DockerPage.Values[6]);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    WriteNativeConfiguration;
    WriteDockerConfiguration;
    WriteAssistantAssets;
    AddNexusToUserPath;
    PersistSettings;
    if not IsSmokeBuild() then
    begin
      if AssistantPage.Values[0] then RunManagedIntegration('connect-copilot-cli.cmd', 'CopilotCliManaged');
      if AssistantPage.Values[2] then RunManagedIntegration('connect-claude-user.cmd', 'ClaudeUserManaged');
    end;
  end;
end;

procedure RemoveManagedAssistantIntegrations;
var
  Value: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged', Value) and (Value = '1') and CommandExists('copilot') then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C "copilot mcp remove nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'CopilotCliManaged');
  end;
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ClaudeUserManaged', Value) and (Value = '1') and CommandExists('claude') then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C "claude mcp remove --scope user nexus"', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ClaudeUserManaged');
  end;
end;

procedure StopManagedDocker;
var
  Value: String;
  ResultCode: Integer;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', Value) and (Value = '1') and FileExists(ExpandConstant('{app}\nexus-docker-down.cmd')) then
  begin
    Exec(ExpandConstant('{cmd}'), '/D /S /C ""' + ExpandConstant('{app}\nexus-docker-down.cmd') + '""', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, ResultCode);
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'DockerManaged');
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    StopManagedDocker;
    RemoveManagedAssistantIntegrations;
    RemoveNexusFromUserPath;
    { NEXUS_HOME is intentionally preserved. }
  end;
end;
