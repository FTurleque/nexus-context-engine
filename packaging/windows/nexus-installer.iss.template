function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = NativeOptionsPage.ID then Result := (not InstallNative()) or (not IsCustomProfile())
  else if PageID = RuntimePage.ID then Result := not IsCustomProfile()
  else if PageID = OllamaPrereqPage.ID then Result := (not OllamaEnabled()) or OllamaPresent()
  else if PageID = OllamaPage.ID then Result := (not OllamaEnabled()) or (not IsCustomProfile())
  else if PageID = DockerPrereqPage.ID then Result := (not InstallDocker()) or DockerRuntimePresent()
  else if PageID = DockerPage.ID then Result := not InstallDocker()
  else if PageID = AssistantPage.ID then Result := not AssistantIntegrationAvailable()
  else if PageID = IntegrationRuntimePage.ID then Result := not (InstallNative() and InstallDocker());
end;

function IsValidDockerName(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  // Syntaxe conteneur Docker : [a-zA-Z0-9][a-zA-Z0-9_.-]* (borne raisonnable de longueur).
  Value := Trim(Value);
  Result := False;
  if (Value = '') or (Length(Value) > 128) then exit;
  C := Value[1];
  if not (((C >= 'a') and (C <= 'z')) or ((C >= 'A') and (C <= 'Z')) or ((C >= '0') and (C <= '9'))) then exit;
  for I := 2 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'a') and (C <= 'z')) or ((C >= 'A') and (C <= 'Z')) or ((C >= '0') and (C <= '9'))
        or (C = '_') or (C = '.') or (C = '-')) then exit;
  end;
  Result := True;
end;

function IsValidRestartPolicy(Value: String): Boolean;
var
  Prefix, Rest: String;
begin
  // Choix fermé Docker : no | always | unless-stopped | on-failure | on-failure:N.
  Value := Lowercase(Trim(Value));
  Result := (Value = 'no') or (Value = 'always') or (Value = 'unless-stopped') or (Value = 'on-failure');
  if Result then exit;
  Prefix := 'on-failure:';
  if Copy(Value, 1, Length(Prefix)) = Prefix then
  begin
    Rest := Copy(Value, Length(Prefix) + 1, Length(Value));
    Result := (Rest <> '') and (StrToIntDef(Rest, -1) >= 0);
  end;
end;

function HasWhitespace(Value: String): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to Length(Value) do
    if (Value[I] = ' ') or (Value[I] = #9) then
    begin
      Result := True;
      exit;
    end;
end;

{ The embedded Java runtime (nexus.exe, java.exe -jar) does not start from a folder whose
  name has a character outside the active ANSI code page, such as U+0141 under code page
  1252. The String -> AnsiString conversion replaces such a character, so the round trip
  changes the name. }
function IsAnsiRoundTrip(Value: String): Boolean;
var
  Ansi: AnsiString;
begin
  Ansi := Value;
  Result := String(Ansi) = Value;
end;

function InstallDirOutsideAnsiMessage(): String;
begin
  Result := 'Le dossier d''installation contient un caractère absent de la page de code ANSI de Windows. ' +
    'Le runtime Java embarqué ne démarre pas depuis un tel dossier : choisissez un dossier sans ce caractère.';
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  PortValue: Integer;
  ResolvedPort: Integer;
  ReservedPort: Integer;
begin
  Result := True;

  if (CurPageID = wpSelectDir) and (not IsAnsiRoundTrip(WizardDirValue())) then
  begin
    MsgBox(InstallDirOutsideAnsiMessage(), mbError, MB_OK);
    Result := False;
    exit;
  end;

  if (CurPageID = NativeOptionsPage.ID) and InstallNative() then
  begin
    if not (NativeOptionsPage.Values[0] or NativeOptionsPage.Values[1] or NativeOptionsPage.Values[2]) then
    begin
      MsgBox('Sélectionnez au moins une surface native.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if CurPageID = RuntimePage.ID then
  begin
    if Trim(RuntimePage.Values[0]) = '' then
    begin
      MsgBox('NEXUS_HOME ne peut pas être vide.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(RuntimePage.Values[2], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST natif doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if InstallNativeRest() then
    begin
      if not IsSafeBindAddress(RuntimePage.Values[1]) then
      begin
        MsgBox('L''adresse d''écoute REST native est vide ou invalide.', mbError, MB_OK);
        Result := False;
        exit;
      end;
      ResolvedPort := FindAvailableTcpPort(RuntimePage.Values[1], PortValue, -1);
      if ResolvedPort < 1 then
      begin
        MsgBox('Aucun port TCP disponible n''a été trouvé pour le REST natif.', mbError, MB_OK);
        Result := False;
        exit;
      end;
      RuntimePage.Values[2] := IntToStr(ResolvedPort);
      NotifyPortSelection('Le port REST natif', PortValue, ResolvedPort);
    end;
    if InstallNativeRest() and (Lowercase(Trim(RuntimePage.Values[1])) <> '127.0.0.1') and (Lowercase(Trim(RuntimePage.Values[1])) <> 'localhost') and (Trim(RuntimePage.Values[3]) = '') then
    begin
      MsgBox('Un token API REST est obligatoire pour une écoute native non-loopback.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;

  if (CurPageID = OllamaPage.ID) and OllamaEnabled() and (Trim(OllamaPage.Values[0]) = '') then
  begin
    MsgBox('L''URL Ollama ne peut pas être vide lorsque Ollama est activé.', mbError, MB_OK);
    Result := False;
    exit;
  end;

  if (CurPageID = DockerPrereqPage.ID) and InstallDocker() and not DockerRuntimePresent() and not DockerPrereqPage.Values[0] then
  begin
    MsgBox('Docker Desktop/CLI n''est pas installé. Cochez l''installation automatique ou installez Docker avant de continuer.', mbError, MB_OK);
    Result := False;
    exit;
  end;

  if CurPageID = DockerPage.ID then
  begin
    if (not DockerRuntimePresent()) and (not DockerDesktopAutoInstallSelected()) then
    begin
      MsgBox('Docker Desktop/CLI n''est pas disponible et son installation automatique n''est pas sélectionnée.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if (Trim(DockerPage.Values[0]) = '') or (Trim(DockerPage.Values[1]) = '') or (Trim(DockerPage.Values[5]) = '') then
    begin
      MsgBox('Image, nom du conteneur et repository Docker sont obligatoires.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if HasWhitespace(Trim(DockerPage.Values[0])) then
    begin
      MsgBox('L''image Docker ne doit pas contenir d''espace (ex. ghcr.io/org/nexus:tag).', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsValidDockerName(DockerPage.Values[1]) then
    begin
      MsgBox('Le nom du conteneur est invalide. Attendu : lettres/chiffres puis [a-zA-Z0-9_.-].', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsValidRestartPolicy(DockerPage.Values[6]) then
    begin
      MsgBox('Restart policy invalide. Valeurs acceptées : no, always, unless-stopped, on-failure, on-failure:N.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not DirExists(Trim(DockerPage.Values[5])) then
    begin
      MsgBox('Le repository / racine de projets à monter est introuvable : ' + Trim(DockerPage.Values[5]), mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not IsSafeBindAddress(DockerPage.Values[2]) then
    begin
      MsgBox('L''adresse d''écoute hôte Docker est vide ou invalide.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    PortValue := StrToIntDef(DockerPage.Values[3], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST hôte Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    ReservedPort := -1;
    if InstallNativeRest() then
      ReservedPort := StrToIntDef(RuntimePage.Values[2], -1);
    if (PortValue <> ReservedPort) and ManagedContainerPublishesPort(DockerPage.Values[1], DockerPage.Values[2], PortValue) then
      ResolvedPort := PortValue
    else
      ResolvedPort := FindAvailableTcpPort(DockerPage.Values[2], PortValue, ReservedPort);
    if ResolvedPort < 1 then
    begin
      MsgBox('Aucun port TCP disponible n''a été trouvé pour le REST Docker.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    DockerPage.Values[3] := IntToStr(ResolvedPort);
    if (ReservedPort = PortValue) and (ResolvedPort <> PortValue) then
      MsgBox(
        'Le port REST hôte Docker ' + IntToStr(PortValue) + ' est déjà réservé au REST natif NEXUS.' + #13#10 +
        'NEXUS utilisera le port TCP disponible ' + IntToStr(ResolvedPort) + ' pour Docker.',
        mbInformation, MB_OK)
    else
      NotifyPortSelection('Le port REST hôte Docker', PortValue, ResolvedPort);

    PortValue := StrToIntDef(DockerPage.Values[4], -1);
    if (PortValue < 1) or (PortValue > 65535) then
    begin
      MsgBox('Le port REST interne Docker doit être compris entre 1 et 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
  end;
end;

function InstallOllamaIfNeeded(): String;
var
  InstallerPath: String;
  ResultCode: Integer;
  DownloadedSize: Int64;
begin
  Result := '';
  // Fail-closed strict : aucun téléchargement ni exécution si la sémantique est désactivée, si
  // Ollama est déjà présent, ou si l'installation automatique n'a pas été explicitement choisie.
  if not OllamaEnabled() or OllamaPresent() then exit;
  if not OllamaAutoInstallSelected() then
  begin
    Result := 'Ollama n''est pas installé et son installation automatique est désactivée. Installez Ollama manuellement (https://ollama.com) avant de démarrer NEXUS.';
    exit;
  end;

  try
    DownloadedSize := DownloadTemporaryFile(
      'https://ollama.com/download/OllamaSetup.exe',
      'NEXUS-Ollama-Installer.exe', '', nil);
    Log('Ollama installer téléchargé depuis le domaine officiel : ' + IntToStr(DownloadedSize) + ' octets.');
  except
    Result := 'Impossible de télécharger Ollama depuis le domaine officiel ollama.com : ' + GetExceptionMessage;
    exit;
  end;

  InstallerPath := ExpandConstant('{tmp}\NEXUS-Ollama-Installer.exe');
  if not FileExists(InstallerPath) then
  begin
    Result := 'Le téléchargement Ollama n''a pas produit le fichier attendu.';
    exit;
  end;

  // Vérification Authenticode obligatoire AVANT toute exécution du binaire téléchargé. Signataire
  // attendu : CN=Ollama Inc. (certificat DigiCert officiel). Aucun fallback « exécuter quand même ».
  if not VerifyOllamaInstaller(InstallerPath) then
  begin
    Log('Signature Authenticode Ollama invalide ou signataire inattendu : installation annulée.');
    Result := 'La signature Authenticode du programme d''installation Ollama est invalide ou le signataire n''est pas Ollama Inc. Installation annulée.';
    exit;
  end;
  Log('Signature Authenticode Ollama validée (CN=Ollama Inc.).');

  if not Exec(InstallerPath, '/S', '', SW_SHOW, ewWaitUntilTerminated, ResultCode) or (ResultCode <> 0) then
  begin
    Result := 'L''installation Ollama a échoué avec le code ' + IntToStr(ResultCode) + '.';
    exit;
  end;

  if not OllamaPresent() then
  begin
    Result := 'Ollama a terminé son installation mais aucun exécutable Ollama n''a été détecté.';
    exit;
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  NeedsRestart := False;
  { Backstop for a reinstall, where the install-folder page is skipped. }
  if not IsAnsiRoundTrip(WizardDirValue()) then
  begin
    Result := InstallDirOutsideAnsiMessage();
    exit;
  end;
  Result := InstallOllamaIfNeeded();
  if Result <> '' then exit;
  Result := InstallDockerDesktopIfNeeded();
end;

{ Generated configuration files other than PowerShell scripts (nexus-native.env.cmd,
  docker\.env, the TOML and JSON fragments) are written in UTF-8 without a BOM.
  SaveStringToFile would convert them to the ANSI code page, where a profile or install
  folder such as "Hélène" or "Łukasz" is altered; a BOM would become part of the first
  .env key read by Compose. SaveStringsToUTF8FileWithoutBOM ends the text with one
  extra line break, which cmd.exe, Compose, TOML and JSON readers ignore. }
procedure SaveUtf8TextFile(Path: String; Text: String);
var
  Lines: TArrayOfString;
begin
  SetArrayLength(Lines, 1);
  Lines[0] := Text;
  if not SaveStringsToUTF8FileWithoutBOM(Path, Lines, False) then
    Log('Unable to write ' + Path);
end;

procedure WriteNativeConfiguration;
var
  Content: String;
begin
  if not InstallNative() then exit;
  ForceDirectories(ExpandConstant('{app}\config'));
  Content := '@echo off' + #13#10 +
    'set "NEXUS_HOME=' + RuntimePage.Values[0] + '"' + #13#10 +
    'set "NEXUS_REST_HOST=' + RuntimePage.Values[1] + '"' + #13#10 +
    'set "NEXUS_REST_PORT=' + RuntimePage.Values[2] + '"' + #13#10 +
    'set "NEXUS_REST_API_TOKEN=' + RuntimePage.Values[3] + '"' + #13#10 +
    'set "NEXUS_SEMANTIC_PROVIDER=' + SemanticProviderValue() + '"' + #13#10 +
    'set "NEXUS_OLLAMA_BASE_URL=' + OllamaPage.Values[0] + '"' + #13#10;
  SaveUtf8TextFile(ExpandConstant('{app}\config\nexus-native.env.cmd'), Content);
end;

{ Build arguments of the local runtime-image fallback: the same OCI labels as the
  Compose build. The revision is the packaged commit; when it is unknown the argument is
  omitted and the image label reads "unknown". }
function ImageBuildArgs(): String;
begin
  Result := '--build-arg NEXUS_IMAGE_VERSION={#NexusVersion} ';
  if '{#NexusRevision}' <> '' then
    Result := Result + '--build-arg NEXUS_IMAGE_REVISION={#NexusRevision} ';
end;

procedure WriteDockerConfiguration;
var
  EnvContent: String;
  ComposeTemplate: AnsiString;
  DockerToken: String;
  UpScript: String;
  DownScript: String;
begin
  if not InstallDocker() then exit;
  ForceDirectories(ExpandConstant('{app}\docker'));
  DockerToken := RuntimePage.Values[3];
  if Trim(DockerToken) = '' then DockerToken := GenerateLocalToken();

  EnvContent :=
    'NEXUS_DOCKER_IMAGE=' + DockerPage.Values[0] + #13#10 +
    'NEXUS_DOCKER_CONTAINER=' + DockerPage.Values[1] + #13#10 +
    'NEXUS_DOCKER_RESTART_POLICY=' + DockerPage.Values[6] + #13#10 +
    'NEXUS_DOCKER_BIND_ADDRESS=' + DockerPage.Values[2] + #13#10 +
    'NEXUS_DOCKER_HOST_PORT=' + DockerPage.Values[3] + #13#10 +
    'NEXUS_DOCKER_CONTAINER_PORT=' + DockerPage.Values[4] + #13#10 +
    'NEXUS_HOME_BIND=nexus-data' + #13#10 +
    'NEXUS_REPOSITORY_BIND=' + DockerPath(DockerPage.Values[5]) + #13#10 +
    'NEXUS_RUNTIME=docker' + #13#10 +
    'NEXUS_SEMANTIC_PROVIDER=' + SemanticProviderValue() + #13#10 +
    'NEXUS_OLLAMA_BASE_URL=' + OllamaPage.Values[0] + #13#10 +
    'NEXUS_REST_API_TOKEN=' + DockerToken + #13#10;
  { OCI labels of the image built on this machine (docker-compose.yml build.args). }
  EnvContent := EnvContent + 'NEXUS_IMAGE_VERSION={#NexusVersion}' + #13#10;
  if '{#NexusRevision}' <> '' then
    EnvContent := EnvContent + 'NEXUS_IMAGE_REVISION={#NexusRevision}' + #13#10;
  SaveUtf8TextFile(ExpandConstant('{app}\docker\.env'), EnvContent);

  if not LoadStringFromFile(ExpandConstant('{app}\docker\docker-compose.yml.template'), ComposeTemplate) then
    RaiseException('Impossible de lire la template Docker Compose installée.');
  SaveStringToFile(ExpandConstant('{app}\docker\docker-compose.yml'), ComposeTemplate, False);

  UpScript := '@echo off' + #13#10 +
    'setlocal EnableExtensions' + #13#10 +
    'set "DOCKER_EXE=docker"' + #13#10 +
    'where docker >nul 2>nul || (' + #13#10 +
    '  if exist "%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe" set "DOCKER_EXE=%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe"' + #13#10 +
    '  if exist "%ProgramFiles%\Docker\Docker\resources\bin\docker.exe" set "DOCKER_EXE=%ProgramFiles%\Docker\Docker\resources\bin\docker.exe"' + #13#10 +
    ')' + #13#10 +
    '"%DOCKER_EXE%" info >nul 2>nul && goto docker_ready' + #13#10 +
    'if exist "%LOCALAPPDATA%\Programs\DockerDesktop\Docker Desktop.exe" start "" "%LOCALAPPDATA%\Programs\DockerDesktop\Docker Desktop.exe"' + #13#10 +
    'if exist "%ProgramFiles%\Docker\Docker\Docker Desktop.exe" start "" "%ProgramFiles%\Docker\Docker\Docker Desktop.exe"' + #13#10 +
    'for /L %%I in (1,1,90) do (' + #13#10 +
    '  "%DOCKER_EXE%" info >nul 2>nul && goto docker_ready' + #13#10 +
    '  timeout /t 2 /nobreak >nul' + #13#10 +
    ')' + #13#10 +
    'echo Docker Desktop n''est pas prêt. Acceptez les conditions Docker ou terminez la configuration WSL 2 puis relancez nexus-docker-up.cmd.' + #13#10 +
    'exit /b 30' + #13#10 +
    ':docker_ready' + #13#10 +
    'set "NEXUS_DOCKER_IMAGE="' + #13#10 +
    'if exist "%~dp0docker\.env" for /f "usebackq tokens=1,* delims==" %%A in ("%~dp0docker\.env") do if /I "%%A"=="NEXUS_DOCKER_IMAGE" set "NEXUS_DOCKER_IMAGE=%%B"' + #13#10 +
    'if "%NEXUS_DOCKER_IMAGE%"=="" echo [NEXUS] NEXUS_DOCKER_IMAGE est absent de docker\.env. & if "%NEXUS_DOCKER_IMAGE%"=="" exit /b 31' + #13#10 +
    '"%DOCKER_EXE%" image inspect "%NEXUS_DOCKER_IMAGE%" >nul 2>nul && goto nexus_image_ready' + #13#10 +
    'echo [NEXUS] Image %NEXUS_DOCKER_IMAGE% absente localement; tentative de telechargement...' + #13#10 +
    '"%DOCKER_EXE%" pull "%NEXUS_DOCKER_IMAGE%" && goto nexus_image_ready' + #13#10 +
    'echo [NEXUS] Image registre indisponible ou privee; construction locale depuis le payload installe...' + #13#10 +
    'if not exist "%~dp0docker\Dockerfile.runtime" echo [NEXUS] Dockerfile.runtime introuvable. & if not exist "%~dp0docker\Dockerfile.runtime" exit /b 32' + #13#10 +
    'if not exist "%~dp0docker\nexus-container-entrypoint.sh" echo [NEXUS] Entrypoint Docker introuvable. & if not exist "%~dp0docker\nexus-container-entrypoint.sh" exit /b 33' + #13#10 +
    '"%DOCKER_EXE%" build --pull --file "%~dp0docker\Dockerfile.runtime" --tag "%NEXUS_DOCKER_IMAGE%" ' + ImageBuildArgs() + '"%~dp0."' + #13#10 +
    'if errorlevel 1 echo [NEXUS] Construction locale de l''image NEXUS echouee. & if errorlevel 1 exit /b 34' + #13#10 +
    ':nexus_image_ready' + #13#10 +
    '"%DOCKER_EXE%" compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" up -d' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  DownScript := '@echo off' + #13#10 +
    'setlocal EnableExtensions' + #13#10 +
    'set "DOCKER_EXE=docker"' + #13#10 +
    'where docker >nul 2>nul || (' + #13#10 +
    '  if exist "%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe" set "DOCKER_EXE=%LOCALAPPDATA%\Programs\DockerDesktop\resources\bin\docker.exe"' + #13#10 +
    '  if exist "%ProgramFiles%\Docker\Docker\resources\bin\docker.exe" set "DOCKER_EXE=%ProgramFiles%\Docker\Docker\resources\bin\docker.exe"' + #13#10 +
    ')' + #13#10 +
    '"%DOCKER_EXE%" compose --env-file "%~dp0docker\.env" -f "%~dp0docker\docker-compose.yml" down' + #13#10 +
    'exit /b %ERRORLEVEL%' + #13#10;
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-up.cmd'), UpScript, False);
  SaveStringToFile(ExpandConstant('{app}\nexus-docker-down.cmd'), DownScript, False);

  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerManaged', '1');
end;

